              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "refId": "A",
                  "query": {
                    "datasource": {
                      "name": "${DS_METRICS}"
                    },
                    "group": "prometheus",
                    "kind": "DataQuery",
                    "spec": {
                      "expr": "count(count by (device_id) (sum_over_time(nav_pilot_local_dispatches_count{version=~\"$version\"}[$__range])))",
                      "legendFormat": ""
                    },
                    "version": "v0"
                  }
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
