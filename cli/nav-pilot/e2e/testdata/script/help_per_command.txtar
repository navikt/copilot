# help <cmd> and <cmd> --help show that command's page, not the global one,
# and the global page documents the launch flags.

exec nav-pilot help sync
stdout '^Usage: nav-pilot sync \[flags\]'
stdout '--apply'
! stdout 'Commands:'
! stderr .

exec nav-pilot sync --help
stdout '^Usage: nav-pilot sync \[flags\]'
stdout '--dry-run'

exec nav-pilot help install
stdout '^Usage: nav-pilot install <name> \[flags\]'

exec nav-pilot i --help
stdout '^Usage: nav-pilot install <name> \[flags\]'

exec nav-pilot help ls
stdout '^Usage: nav-pilot list \[flags\]'

exec nav-pilot config --help
stdout '^Usage: nav-pilot config \[subcommand\]'
stdout 'setup \[--force\]'

# Every command has a page of its own (#1040).
exec nav-pilot help doctor
stdout '^Usage: nav-pilot doctor'
! stdout 'Commands:'
! stderr .

exec nav-pilot validate --help
stdout '^Usage: nav-pilot validate'
stdout 'Exit codes: 0 valid, 1 violations found'

exec nav-pilot env -h
stdout '^Usage: nav-pilot env'
stdout 'eval "\$\(nav-pilot env\)"'

# So does each alpha local subcommand, and --help exits 0 on the ones that
# parse their own flags.
exec nav-pilot alpha local status --help
stdout '^Usage: nav-pilot alpha local status'
! stdout 'features that are not supported yet'
! stderr .

exec nav-pilot alpha local setup --help
stdout '^Usage: nav-pilot alpha local setup \[flags\]'
stdout '--fix-context'
! stderr .

exec nav-pilot alpha local ask --help
stdout '^Usage: nav-pilot alpha local ask'
! stderr .

# For ask the words are the question: a -h inside it is not help.
! exec nav-pilot alpha local ask what does -h mean
! stdout 'Usage:'
stderr 'no local server is running'

exec nav-pilot help alpha local purge
stdout '^Usage: nav-pilot alpha local purge'

exec nav-pilot --help
stdout 'Launch flags'
stdout '--client <name>'
stdout '--persona <name>'
stdout '--model <id>'
stdout '--mode <mode>'
stdout '--effort <level>'
stdout '--context <tier>'
stdout '--allow-all-tools'
stdout '--no-auto-launch'
stdout '--no-sandbox'
