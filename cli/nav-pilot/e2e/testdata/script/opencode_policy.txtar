# Every opencode session nav-pilot launches keeps sharing off and updates to a
# notice, whatever the user's opencode.json says (#1027). The policy rides in
# OPENCODE_CONFIG_CONTENT, so the user's file is not rewritten for it. An
# opencode 2 outside the tested range gets a warning, not a refusal, and doctor
# says which version it found. opencode 1 is refused.

fake-bin cplt opencode
env PATH=$PATH${:}/bin${:}/usr/bin

mkdir plattform/skills repo home/.config/opencode
cp manual.json home/.config/opencode/opencode.json
cd plattform
exec git init -q .
exec git add -A
exec git -c user.email=e2e@example.test -c user.name=e2e commit -qm innhold
cd ../repo
exec git init -q .
exec nav-pilot config set source $WORK/plattform
exec nav-pilot install plattform --user --yes

env OC_VERSION='opencode v2.1.3'
exec /bin/sh -c 'nav-pilot --client opencode --model claude-opus-4.8 -- run x </dev/null'
grep '^--pass-env\nOPENCODE_CONFIG_CONTENT\n' $WORK/fake/cplt.log
exec cat $WORK/env.out
stdout '"share":"disabled"'
stdout '"autoupdate":"notify"'
stdout '"enabled_providers":\["github-copilot"\]'
grep '"share": "manual"' $HOME/.config/opencode/opencode.json
! stderr 'outside the tested range'

# A new opencode is a new binary: the version nav-pilot keeps is for the old one.
env OC_VERSION='opencode v2.2.0'
exec touch $WORK/fake/opencode
exec /bin/sh -c 'nav-pilot --client opencode --model claude-opus-4.8 -- run x </dev/null'
stderr 'opencode 2\.2\.0 is outside the tested range \(>=2\.0\.24,<2\.2\)'
exec cat $WORK/env.out
stdout '"share":"disabled"'

exec nav-pilot doctor
stdout 'Version 2\.2\.0 is outside the tested range'
env OC_VERSION='opencode v2.1.3'
exec touch $WORK/fake/opencode
exec nav-pilot doctor
stdout 'Version 2\.1\.3 is inside the tested range'

# opencode 1 is refused before cplt starts (#1907), with the upgrade command.
env OC_VERSION=1.18.32
exec touch $WORK/fake/opencode
rm $WORK/env.out
! exec /bin/sh -c 'nav-pilot --client opencode --model claude-opus-4.8 -- run x </dev/null'
stderr 'opencode 1\.18\.32 is no longer supported'
stderr 'Upgrade to opencode 2: .*@opencode/cli@'
! exists $WORK/env.out
exec nav-pilot doctor
stdout 'no longer supported'
env OC_VERSION='opencode v2.1.3'
exec touch $WORK/fake/opencode

# A global v2 policy outranks inline config: refuse before cplt starts.
cp $WORK/broader.json $HOME/.config/opencode/opencode.json
rm $WORK/env.out
! exec /bin/sh -c 'nav-pilot --client opencode --model claude-opus-4.8 -- run x </dev/null'
stderr 'enables provider opencode \(enabled_providers\) in .*conflicts'
! exists $WORK/env.out

-- fake/opencode.sh --
for a in "$@"; do last=$a; done
[ "$last" = --version ] && { echo "$OC_VERSION"; exit 0; }
-- fake/cplt.sh --
for a in "$@"; do last=$a; done
[ "$last" = --version ] && { echo 'cplt 2026.10.22-172931-b37a8ab'; exit 0; }
env | grep '^OPENCODE_CONFIG_CONTENT=' > "$WORK/env.out"
-- manual.json --
{"share": "manual"}
-- broader.json --
{"enabled_providers":["opencode","github-copilot"]}
-- plattform/.nav-pilot/agentpakke.json --
{"contractVersion":"1","name":"plattform","description":"plattform","layout":{"agents":"agents","skills":"skills"},"clients":{"copilot":{"primaryAgents":["grillmester"]},"opencode":{"primaryAgents":["grillmester"]}}}
-- plattform/agents/grillmester.agent.md --
---
name: grillmester
description: fra plattform
---
plattform
