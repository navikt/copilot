# Client args after -- are an explicit launch: nav-pilot starts the client with
# those args unchanged (after its own --agent), with or without a terminal. No
# menu, no prompt, no sync: a benchmark or CI run must not rewrite ~/.copilot.
# --sync stays opt-in. What would need a yes fails with the flag to pass.
# opencode here: a copilot launch still writes nav-pilot's built-in hooks to
# ~/.copilot/hooks, as every copilot launch does.

fake-bin cplt opencode

mkdir plattform/skills repo
cd plattform
exec git init -q .
exec git add -A
exec git -c user.email=e2e@example.test -c user.name=e2e commit -qm innhold

cd ../repo
exec git init -q .
exec nav-pilot config set source $WORK/plattform

# Nothing installed: installing needs consent, so exit 2 with the command.
exits 2 nav-pilot --client opencode -- run -p 'review this PR'
stderr 'nothing is installed.*Install first: nav-pilot install --user --all --yes'
! exists $HOME/.copilot
! exists $WORK/fake/cplt.log

exec nav-pilot install plattform --user --yes

# A local edit, and a newer source: a sync would replace the edit.
cp $WORK/edited.md $HOME/.copilot/agents/grillmester.agent.md
cp $WORK/newer.md $WORK/plattform/agents/grillmester.agent.md
cd $WORK/plattform
exec git -c user.email=e2e@example.test -c user.name=e2e commit -qam nyere
cd $WORK/repo
exec /usr/bin/find $HOME/.copilot -type f
cp stdout $WORK/before.txt

# No terminal: launches with exactly the args after --.
exec /bin/sh -c 'nav-pilot --client opencode -- run -p "review this PR" </dev/null'
! stderr 'Not launching'
! stdout 'synced'
grep '^--yes\n' $WORK/fake/cplt.log
grep '^--\nrun\n--agent\ngrillmester\n--auto\n-p\nreview this PR\n---' $WORK/fake/cplt.log
grep 'lokal endring' $HOME/.copilot/agents/grillmester.agent.md
exec /usr/bin/find $HOME/.copilot -type f
cmp stdout $WORK/before.txt

# A bare trailing -- is nothing to run: the hint does not repeat it.
exits 1 /bin/sh -c 'nav-pilot --client opencode -- </dev/null'
stderr 'nav-pilot --client opencode -- -p "…"$'
! stderr '-- --'

# The safety refusals still hold: not from $HOME without --project-dir, and
# never without cplt.
cd $HOME
exits 1 nav-pilot --client opencode -- run -p x
stderr 'Not launching from your home directory'
cd $WORK
rm fake/cplt
fake-bin copilot
cd repo
exits 1 nav-pilot -- -p x
stderr 'Not launching: cplt is not installed'
! grep '^-p' $WORK/fake/copilot.log
cd $WORK
fake-bin cplt
cd repo

# A pseudo-terminal: still no menu and no sync, straight to the client.
[!pty] stop
rm $WORK/fake/cplt.log
exits 0 pty-run -- nav-pilot --client opencode -- run -p 'review this PR'
! stdout 'Sync now\?|Which coding agent|Install .* to ~/.copilot'
grep '^--\nrun\n--agent\ngrillmester\n--auto\n-p\nreview this PR\n---' $WORK/fake/cplt.log
grep 'lokal endring' $HOME/.copilot/agents/grillmester.agent.md
exec /usr/bin/find $HOME/.copilot -type f
cmp stdout $WORK/before.txt

-- edited.md --
---
name: grillmester
description: fra plattform
---
lokal endring
-- newer.md --
---
name: grillmester
description: fra plattform
---
nyere
-- plattform/.nav-pilot/agentpakke.json --
{"contractVersion":"1","name":"plattform","description":"plattform","layout":{"agents":"agents","skills":"skills"},"clients":{"copilot":{"primaryAgents":["grillmester"]},"opencode":{"primaryAgents":["grillmester"]}}}
-- plattform/agents/grillmester.agent.md --
---
name: grillmester
description: fra plattform
---
plattform
