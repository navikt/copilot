# auth logout says what it did (#1274): with nothing stored it says so,
# and a revoke that fails names the page to revoke the token by hand.
# The e2e build keeps the keychain in memory, never the real one.

exec nav-pilot auth logout
stdout 'Not logged in; nothing to remove'
! stdout 'Logged out'

# copilot-cli out of reach: the token goes, and the way to revoke it is named.
env NAV_PILOT_E2E_KEYCHAIN_TOKEN=gho_e2e
env NAV_PILOT_COPILOT_CLI_URL=http://127.0.0.1:9
exec nav-pilot auth logout
stdout '^  ⚠ Could not revoke the token at GitHub: could not reach copilot-cli \(is naisdevice connected\?\)\.$'
! stdout 'dial tcp'
stdout 'remove nav-pilot under Authorized GitHub Apps: https://github.com/settings/apps/authorizations'
stdout 'Logged out\. Token removed from OS keychain'

# With an App override, the page that lists OAuth Apps too.
env NAV_PILOT_GITHUB_CLIENT_ID=Iv1.other
exec nav-pilot auth logout
stdout 'Authorized GitHub Apps or Authorized OAuth Apps: https://github.com/settings/applications'
env NAV_PILOT_GITHUB_CLIENT_ID=

# usage says copilot-cli is out of reach in one Norwegian line (#1300).
exits 1 nav-pilot usage
stderr 'fikk ikke kontakt med copilot-cli \(er naisdevice på\?\)$'
! stderr 'dial tcp|bruksdata'

# usage speaks Norwegian all the way, the prefix too (#1297), and exits 1.
env NAV_PILOT_E2E_KEYCHAIN_TOKEN=
exits 1 nav-pilot usage
stderr '^Feil: ikke logget inn: kjør .nav-pilot auth login. først'
! stderr 'Error'

# English commands keep the English prefix.
exits 1 nav-pilot auth nosuch
stderr '^Error: '
