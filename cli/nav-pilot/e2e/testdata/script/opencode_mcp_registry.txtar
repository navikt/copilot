# An opencode launch applies the MCP registry policy Copilot CLI applies
# (#1027): it asks GitHub which registry Nav's org policy names (gh api
# /copilot/mcp_registry) and turns off, for this session only, every MCP server
# that registry does not list. Remote servers match by URL, local ones by the
# npm package in their command. The user's opencode.json is not edited. A
# registry that does not answer changes nothing, with a warning, and so does a
# policy that allows every server.

mkdir bin
[exec:node] exec node -e 'require("fs").symlinkSync(process.execPath, "bin/node")'
fake-bin cplt opencode gh
env PATH=$PATH${:}/bin${:}/usr/bin
fake-mcp-registry registry.json

mkdir plattform/skills repo home/.config/opencode
cp user.json home/.config/opencode/opencode.json
cd plattform
exec git init -q .
exec git add -A
exec git -c user.email=e2e@example.test -c user.name=e2e commit -qm innhold
cd ../repo
exec git init -q .
cp ../project.json opencode.json
exec nav-pilot config set source $WORK/plattform
exec nav-pilot install plattform --user --yes

# registry_only: the unlisted remote and local servers are turned off.
env POLICY=registry_only
exec /bin/sh -c 'nav-pilot --client opencode --model claude-opus-4.8 -- run x </dev/null'
stderr 'MCP servers turned off for this session \(not in Nav''s MCP registry\): egen-lokal, tredjepart\. See https://ki-utvikling\.nav\.no/verktoy'
exec cat $WORK/env.out
stdout '"tredjepart":\{"enabled":false\}'
stdout '"egen-lokal":\{"enabled":false\}'
! stdout '"aksel"'
! stdout '"playwright"'
! stdout '"av"'
cmp $HOME/.config/opencode/opencode.json $WORK/user.json

grep '^--pass-env\nNAV_PILOT_MCP_BLOCKED\n' $WORK/fake/cplt.log
[exec:node] exec cat $WORK/gate.out
[exec:node] stdout '^tredjepart_search: denied: nav-pilot: the MCP server tredjepart is not in Nav''s MCP registry'
[exec:node] stdout '^aksel_find_docs: allowed$'
[exec:node] stdout '^bash: allowed$'
[exec:node] stdout '^read_mcp_resource: denied: nav-pilot: the MCP server tredjepart'
[exec:node] stdout '^list_mcp_resources: allowed$'

exec nav-pilot doctor
stdout 'MCP servers turned off at launch \(not in Nav''s MCP registry\): egen-lokal, tredjepart'

# With every hook off, the session policy still reaches opencode.
exec nav-pilot config set hook_loop_guard false
exec nav-pilot config set hook_redact_secrets false
exec nav-pilot config set hook_redact_fnr false
exec nav-pilot config set hook_injection_note false
exec /bin/sh -c 'nav-pilot --client opencode --model claude-opus-4.8 -- run x </dev/null'
grep '^--pass-env\nOPENCODE_CONFIG_CONTENT\n' $WORK/fake/cplt.log
exec cat $WORK/env.out
stdout '"share":"disabled"'
stdout '"tredjepart":\{"enabled":false\}'

# A policy that allows every server: nothing is turned off.
env POLICY=allow_all
exec /bin/sh -c 'nav-pilot --client opencode --model claude-opus-4.8 -- run x </dev/null'
! stderr 'MCP servers turned off'
exec cat $WORK/env.out
! stdout 'enabled'

# The registry does not answer: nothing is turned off, and it says so.
env POLICY=registry_only
env MCP_REGISTRY_URL=http://127.0.0.1:1/
exec /bin/sh -c 'nav-pilot --client opencode --model claude-opus-4.8 -- run x </dev/null'
stderr 'MCP servers were not checked against Nav''s MCP registry'
exec cat $WORK/env.out
! stdout 'enabled'

-- fake/gh.sh --
if [ "$1 $2" = "api /copilot/mcp_registry" ]; then
  echo "{\"mcp_registries\":[{\"url\":\"$MCP_REGISTRY_URL\",\"registry_access\":\"$POLICY\",\"owner\":{\"priority\":1}}]}"
  exit 0
fi
-- fake/cplt.sh --
env | grep '^OPENCODE_CONFIG_CONTENT=' > "$WORK/env.out"
# Play opencode: call the plugin's gate for a blocked, a listed and a built-in tool.
if [ -x "$WORK/bin/node" ]; then "$WORK/bin/node" "$WORK/gate.mjs" > "$WORK/gate.out" 2>&1; fi
-- gate.mjs --
const cfg = JSON.parse(process.env.OPENCODE_CONFIG_CONTENT)
const mod = await import(cfg.plugin[0])
const hooks = await mod.NavPilotHooks({ directory: process.cwd(), worktree: process.cwd() })
for (const [tool, args] of [["tredjepart_search", {}], ["aksel_find_docs", {}], ["bash", {}], ["read_mcp_resource", { server: "tredjepart", uri: "x" }], ["list_mcp_resources", {}]]) {
  try {
    await hooks["tool.execute.before"]({ tool, sessionID: "s", callID: "c" }, { args })
    console.log(`${tool}: allowed`)
  } catch (e) {
    console.log(`${tool}: denied: ${e.message}`)
  }
}
-- registry.json --
{"servers":[
  {"server":{"name":"io.github.navikt/aksel-mcp","remotes":[{"type":"streamable-http","url":"https://aksel-mcp.nav.no/mcp"}]}},
  {"server":{"name":"com.microsoft/playwright-mcp","packages":[{"registryType":"npm","identifier":"@playwright/mcp"}]}}
],"metadata":{"count":2}}
-- user.json --
{
  // the developer's own servers
  "mcp": {
    "aksel": {"type": "remote", "url": "https://aksel-mcp.nav.no/mcp/"},
    "tredjepart": {"type": "remote", "url": "https://mcp.example.com/sse"},
    "av": {"type": "remote", "url": "https://off.example.com", "enabled": false},
  }
}
-- project.json --
{"mcp": {
  "playwright": {"type": "local", "command": ["npx", "-y", "@playwright/mcp@latest"]},
  "egen-lokal": {"type": "local", "command": ["node", "./server.js"]}
}}
-- plattform/.nav-pilot/agentpakke.json --
{"contractVersion":"1","name":"plattform","description":"plattform","layout":{"agents":"agents","skills":"skills"},"clients":{"copilot":{"primaryAgents":["grillmester"]},"opencode":{"primaryAgents":["grillmester"]}}}
-- plattform/agents/grillmester.agent.md --
---
name: grillmester
description: fra plattform
---
plattform
