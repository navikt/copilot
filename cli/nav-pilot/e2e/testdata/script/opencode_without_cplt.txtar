# opencode without cplt, as copilot: nav-pilot never launches it outside the
# sandbox, with or without a terminal, and --no-sandbox is refused with the
# reason.

fake-bin opencode
env PATH=$PATH${:}/bin${:}/usr/bin

mkdir plattform/skills repo
cd plattform
exec git init -q .
exec git add -A
exec git -c user.email=e2e@example.test -c user.name=e2e commit -qm innhold
cd ../repo
exec git init -q .
exec nav-pilot config set source $WORK/plattform
exec nav-pilot install plattform --user --yes

exits 1 nav-pilot --client opencode --model claude-opus-4.8 -- run hello
stderr 'Not launching: cplt is not installed\. Install it: brew install navikt/tap/cplt'
! exists $WORK/fake/opencode.log

exits 1 nav-pilot --client opencode --model claude-opus-4.8 --no-sandbox -- run hello
stderr 'nav-pilot always runs clients inside cplt'
! exists $WORK/fake/opencode.log

# In a terminal it says so and launches nothing.
[!pty] stop 'no pseudo-terminal here (/dev/ptmx will not open)'
exec nav-pilot config set client opencode
exits 0 pty-run -- nav-pilot
stdout 'cplt \(the sandbox\) is not installed, and opencode only launches inside it'
! exists $WORK/fake/opencode.log

-- plattform/.nav-pilot/agentpakke.json --
{"contractVersion":"1","name":"plattform","description":"plattform","layout":{"agents":"agents","skills":"skills"},"clients":{"copilot":{"primaryAgents":["grillmester"]},"opencode":{"primaryAgents":["grillmester"]}}}
-- plattform/agents/grillmester.agent.md --
---
name: grillmester
description: fra plattform
---
plattform
