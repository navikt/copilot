# With stdin on a terminal and stderr redirected there is no spinner, but keys
# pressed during the fetch are still dropped and not echoed (#1287). The
# install question goes to stderr, so the git wrapper announces the fetch and
# its end on the terminal, and the test answers the question after that.

[!pty] skip 'no pseudo-terminal here (/dev/ptmx will not open)'

fake-bin cplt copilot
mkdir $WORK/real
mv $WORK/fake/git $WORK/real/git
cp slowgit $WORK/fake/git
chmod 755 $WORK/fake/git
env REAL_GIT=$WORK/real/git

mkdir plattform
cd plattform
exec git init -q .
exec git add -A
exec git -c user.email=e2e@example.test -c user.name=e2e commit -qm innhold

cd $HOME
exec git config --global url.file://$WORK/plattform.insteadOf https://github.com/navikt/plattform.git
exec nav-pilot config set source navikt/plattform
exec nav-pilot config set rtk_prompted_client copilot

exits 0 pty-run -wait 'slow fetch' -send 'zqx\r' -wait 'checked out' -send '\r' -- /bin/sh -c 'exec nav-pilot 2>$WORK/stderr.log'
stdout 'Installed\. cd into a project and run nav-pilot'
! stdout zqx
! stdout 'Agents \(1 available\)'
exists $HOME/.copilot/hooks/vakt.py

-- plattform/.nav-pilot/agentpakke.json --
{"contractVersion":"1","name":"plattform","description":"plattform","layout":{"agents":"agents","hooks":"hooks"},"clients":{"copilot":{"primaryAgents":["grillmester"]}}}
-- plattform/agents/grillmester.agent.md --
---
name: grillmester
description: fra plattform
---
plattform
-- plattform/hooks/vakt.hook.json --
{"matcher": "bash", "timeoutSec": 5}
-- plattform/hooks/vakt.py --
print("ok")
-- slowgit --
#!/bin/sh
[ "$1" = fetch ] && echo "slow fetch" >/dev/tty && /bin/sleep 2
"$REAL_GIT" "$@" || exit
[ "$3" = checkout ] && echo "checked out" >/dev/tty
exit 0
