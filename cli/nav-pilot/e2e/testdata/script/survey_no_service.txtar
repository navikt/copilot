# nav-pilot survey with nothing to answer: no active survey, the gateway
# answering 404 (Nav's ingress where copilot-cli is not deployed), a 5xx
# (copilot-cli up but copilot-survey not, e.g. a missing secret). Each says
# there is nothing open and exits 0 (#1179). No answer within the timeout, or
# no connection, is copilot-cli out of reach: one line, exit 1 (#1300).

env NAV_PILOT_E2E_GITHUB_TOKEN=gho_e2e

fake-survey -empty
exec nav-pilot survey
stdout '^Ingen åpne undersøkelser akkurat nå\.$'
exec nav-pilot survey --json
stdout '^\[\]$'

fake-survey -404
exec nav-pilot survey
stdout '^Ingen åpne undersøkelser akkurat nå\.$'
! stderr .

fake-survey -502
exec nav-pilot survey
stdout '^Ingen åpne undersøkelser akkurat nå\.$'
! stderr .

fake-survey -503
exec nav-pilot survey
stdout '^Ingen åpne undersøkelser akkurat nå\.$'
! stderr .

fake-survey -hang
exits -within 10s 1 nav-pilot survey
! stdout .
stderr 'fikk ikke kontakt med copilot-cli \(er naisdevice på\?\)$'
! stderr 'deadline'

env NAV_PILOT_COPILOT_CLI_URL=http://127.0.0.1:9
exits 1 nav-pilot survey
! stdout .
stderr 'fikk ikke kontakt med copilot-cli \(er naisdevice på'
! stderr 'dial tcp'
