# Without cplt, copilot would run unsandboxed. The way to get the sandbox is
# named (the old remedy, `nav-pilot config setup`, installs nothing). Without a
# terminal it refuses unless --no-sandbox says to go ahead. A plain copilot is
# asked whether it is cplt once per run, not once per lookup.

fake-bin copilot

mkdir plattform/skills repo
cd plattform
exec git init -q .
exec git add -A
exec git -c user.email=e2e@example.test -c user.name=e2e commit -qm innhold
cd ../repo
exec git init -q .
exec nav-pilot install plattform --source $WORK/plattform --repo
rm $WORK/fake/copilot.log

exits 1 nav-pilot --sync --source $WORK/plattform -- -p 'hello'
stderr 'Install cplt: brew install navikt/tap/cplt \(or sudo apt install cplt\)'
stderr 'Or pass --no-sandbox to run it anyway\.'
! stderr 'config setup'
! grep 'hello' $WORK/fake/copilot.log
grep -count=1 '^--version\n' $WORK/fake/copilot.log

rm $WORK/fake/copilot.log
exec nav-pilot --sync --source $WORK/plattform --no-sandbox -- -p 'hello'
stderr '⚠ cplt \(the sandbox\) is not installed: copilot runs unsandboxed \(--no-sandbox\)\.'
grep '^-p\nhello\n---' $WORK/fake/copilot.log
grep -count=1 '^--version\n' $WORK/fake/copilot.log

# In a terminal it asks, and the answer defaults to no.
[!pty] stop 'no pseudo-terminal here (/dev/ptmx will not open)'
exec nav-pilot config set rtk_prompted_client copilot
rm $WORK/fake/copilot.log
exits 0 pty-run -wait 'Launch copilot without the sandbox' -send '\r' -- nav-pilot
stdout 'cplt \(the sandbox\) is not installed\. Install it: brew install navikt/tap/cplt \(or sudo apt install cplt\)'
stdout 'Not launched\.'
! grep '^--agent' $WORK/fake/copilot.log

-- plattform/.nav-pilot/agentpakke.json --
{"contractVersion":"1","name":"plattform","description":"plattform","layout":{"agents":"agents","skills":"skills"},"clients":{"copilot":{"primaryAgents":["grillmester"]}}}
-- plattform/agents/grillmester.agent.md --
---
name: grillmester
description: fra plattform
---
plattform
