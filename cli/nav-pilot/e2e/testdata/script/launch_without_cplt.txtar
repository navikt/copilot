# Without cplt, copilot is never launched: nav-pilot runs clients only inside
# the sandbox, and names how to install it (the old remedy, `nav-pilot config
# setup`, installs nothing). --no-sandbox is gone and says so. A plain copilot is
# asked whether it is cplt once per installed binary, not once per lookup or
# per run: the answer is kept in client-versions.json.

fake-bin copilot

mkdir plattform/skills repo
cd plattform
exec git init -q .
exec git add -A
exec git -c user.email=e2e@example.test -c user.name=e2e commit -qm innhold
cd ../repo
exec git init -q .
exec nav-pilot install plattform --source $WORK/plattform --repo --yes
rm $WORK/fake/copilot.log

exits 1 nav-pilot --sync --source $WORK/plattform -- -p 'hello'
stderr 'Not launching: cplt is not installed\. Install it: brew install navikt/tap/cplt \(or sudo apt install cplt\)'
! stderr 'config setup'
# Not run, and not asked again: install already asked for its version.
! exists $WORK/fake/copilot.log

exits 1 nav-pilot --sync --source $WORK/plattform --no-sandbox -- -p 'hello'
stderr 'nav-pilot always runs clients inside cplt'
stderr 'brew install navikt/tap/cplt'
! exists $WORK/fake/copilot.log

# In a terminal it says the same and launches nothing.
[!pty] stop 'no pseudo-terminal here (/dev/ptmx will not open)'
exec nav-pilot config set client copilot
exits 0 pty-run -- nav-pilot
stdout 'cplt \(the sandbox\) is not installed, and copilot only launches inside it\. Install it: brew install navikt/tap/cplt \(or sudo apt install cplt\)'
! exists $WORK/fake/copilot.log

-- plattform/.nav-pilot/agentpakke.json --
{"contractVersion":"1","name":"plattform","description":"plattform","layout":{"agents":"agents","skills":"skills"},"clients":{"copilot":{"primaryAgents":["grillmester"]}}}
-- plattform/agents/grillmester.agent.md --
---
name: grillmester
description: fra plattform
---
plattform
