# On the settings page, Esc cancels an edit in the picker (it used to do
# nothing), the picker names its keys, the model picker offers "Other…" near
# the top, and leaving the page says what was saved.

[!pty] skip 'no pseudo-terminal here (/dev/ptmx will not open)'

fake-bin cplt
cp cfg.toml home/config.toml

exec pty-run -wait 'esc close' -send '\r' -wait 'esc cancel' -send '\x1b' -wait 'esc close' -send '\x1b[B\x1b[B\r' -wait 'esc cancel' -send '\x1b' -wait 'esc close' -send '\x03' -- nav-pilot config
stdout 'Other… \(type a model id\)'
stdout 'No changes\.'
cmp home/config.toml cfg.toml

exec pty-run -wait 'esc close' -send '\r' -wait 'esc cancel' -send '\x1b[B\r' -wait 'esc close' -send '\x03' -- nav-pilot config
stdout 'Saved 1 change to .*config\.toml'
! cmp home/config.toml cfg.toml

-- cfg.toml --
version = 1
client = "copilot"
