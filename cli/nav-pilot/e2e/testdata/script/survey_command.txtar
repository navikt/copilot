# nav-pilot survey is asked for, so it works when the automatic prompts do
# not: with surveys = false, with DO_NOT_TRACK, after "never". It still needs
# a terminal to answer (without one, or with --json, it lists), a sign-in,
# and copilot-cli still refuses a second answer.

[!pty] skip 'no pseudo-terminal here (/dev/ptmx will not open)'

env NAV_PILOT_TELEMETRY_ENABLED=true
env DO_NOT_TRACK=
env NAV_PILOT_TELEMETRY_ENDPOINT=http://127.0.0.1:9/v1/metrics
env NAV_PILOT_E2E_GITHUB_TOKEN=gho_e2e
fake-survey
fake-bin cplt copilot

mkdir plattform/skills repo
cd plattform
exec git init -q .
exec git add -A
exec git -c user.email=e2e@example.test -c user.name=e2e commit -qm innhold
cd ../repo
exec git init -q .
exec nav-pilot install plattform --source $WORK/plattform --repo --yes
exec nav-pilot config set client copilot

# No terminal: a list, not a form.
exec nav-pilot survey
stdout '^e2e-2026  E2E survey \(4 spørsmål, åpen til 2099-12-31\)$'
stdout 'Kjør nav-pilot survey i en terminal for å svare'
exec nav-pilot survey --json
validjson stdout
stdout '"id": "e2e-2026"'
! exists $WORK/survey-posts.log

# Opted out of the automatic prompts, and "never" said before: still works.
exec nav-pilot config set surveys false
env DO_NOT_TRACK=1
exec pty-run -wait 'How useful is nav-pilot' -send '\x1b[B\r' -wait 'Velg opptil 2' -send ' \r' -wait 'Anything else' -send '\r' -- nav-pilot survey
stdout 'Dette sendes: svarene dine'
stdout 'Takk! Svaret ditt er sendt'
grep -count=1 '^POST 201 ' $WORK/survey-posts.log

# Again: copilot-cli refuses the second answer.
exec pty-run -wait 'How useful is nav-pilot' -send '\x1b[B\r' -wait 'Velg opptil 2' -send ' \r' -wait 'Anything else' -send '\r' -- nav-pilot survey
stdout 'Du har allerede svart på denne undersøkelsen'

# Not signed in: the login is announced before the questions, and when it
# fails the answer is kept (#1274). The e2e proxy blocks github.com.
env NAV_PILOT_E2E_GITHUB_TOKEN=
exec pty-run -wait 'How useful is nav-pilot' -send '\x1b[B\r' -wait 'Velg opptil 2' -send ' \r' -wait 'Anything else' -send '\r' -- nav-pilot survey
stdout 'Etter siste spørsmål må du logge inn med GitHub for å sende svaret'
stdout 'Svaret er lagret'

# No sign-in, and no GitHub App to sign in with.
env NAV_PILOT_GITHUB_CLIENT_ID=Iv1.nav-pilot-devflow
! exec pty-run -- nav-pilot survey
stdout 'du må logge inn med GitHub for å svare'

-- home/surveys.json --
{"surveys":{"e2e-2026":{"asks":3,"done":"never"}}}
-- plattform/.nav-pilot/agentpakke.json --
{"contractVersion":"1","name":"plattform","description":"plattform","layout":{"agents":"agents","skills":"skills"},"clients":{"copilot":{"primaryAgents":["grillmester"]}}}
-- plattform/agents/grillmester.agent.md --
---
name: grillmester
description: fra plattform
---
plattform
