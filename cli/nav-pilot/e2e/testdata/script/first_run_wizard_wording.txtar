# The first-run wizard says what leaving the model unset does (the
# agentpakke's default, the agent's own if it names none), the auto-update
# answer says what "no" means, and there is no rtk question (#1321).

[!pty] skip 'no pseudo-terminal here (/dev/ptmx will not open)'

# No opencode and no Homebrew: Enter on the preselected opencode saves
# copilot, so the rest of the wizard is the copilot one.
fake-bin cplt copilot

exits 130 pty-run -wait 'Which coding agent' -send '\r' -wait 'Install it now' -send '\x1b[C\r' -wait 'Conversation mode' -send '\r' -wait 'without asking' -send '\r' -wait 'Model' -send '\x03' -- nav-pilot
stdout 'leave it unset for the agentpakke.s default \(the agent.s own if it names none\)'
stdout 'Unset \(agentpakke default\)'

rm home/config.toml
exits 130 pty-run -wait 'Which coding agent' -send '\r' -wait 'Install it now' -send '\x1b[C\r' -wait 'Conversation mode' -send '\r' -wait 'without asking' -send '\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\x03' -- nav-pilot
stdout 'No: say when a new version is out, and ask to upgrade once 7 days behind'

# With a config, the launch goes on without offering rtk, and a config that
# still holds the old rtk bookkeeping keys loads without a word. (The run
# then fails to reach the default source, which the e2e proxy blocks.)
exec nav-pilot config set client copilot
exec /bin/sh -c 'printf "rtk_prompted_client = \"copilot\"\nrtk_prompted_at = \"2026-01-02T03:04:05Z\"\n" >> home/config.toml'
exits 1 pty-run -- nav-pilot
! stdout 'rtk|unknown key'
grep 'rtk_prompted_client = "copilot"' home/config.toml
