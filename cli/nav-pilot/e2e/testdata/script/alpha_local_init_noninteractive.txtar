# init from a script (no TTY) must not start a 25 GB download on its own. It
# refuses before printing the plan, downloads nothing, and says how to
# consent: --yes. stdout stays empty, and the refusal is the last thing said.

[!darwin] skip 'local inference needs an Apple Silicon Mac'
[!arm64] skip 'local inference needs an Apple Silicon Mac'

exits 2 nav-pilot alpha local init
! stdout .
stderr 'init would download about 26 GB\. Run it in a terminal, or pass --yes\n$'
! stderr 'While this is alpha'
! stderr 'downloading'
! exists home/.nav-pilot/local/bin/uv
! exists home/.nav-pilot/local/venv

-- home/.nav-pilot/local-models.json --
{
  "schema_version": 1,
  "channel": "alpha",
  "models": [
    {
      "key": "qwen3.6-35b-a3b-optiq",
      "name": "Qwen 3.6 35B A3B OptiQ 4bit",
      "model": "mlx-community/Qwen3.6-35B-A3B-OptiQ-4bit",
      "backend": "mlx-lm",
      "default": true,
      "weights_gb": 25,
      "min_ram_gb": 8,
      "wired_limit_gb": 4,
      "params": {"MLX_OPENCODE_CONTEXT": "65536"}
    },
    {
      "key": "gemma3-4b",
      "name": "Gemma 3 4B",
      "model": "mlx-community/gemma-3-4b-it-4bit",
      "backend": "mlx-lm",
      "weights_gb": 3,
      "min_ram_gb": 8,
      "wired_limit_gb": 4,
      "params": {"MLX_OPENCODE_CONTEXT": "32768"}
    }
  ]
}
