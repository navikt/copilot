# #1022: opencode is the default on a new install, in a terminal. A headless
# or CI run with no config.toml cannot be told from an existing user who never
# had one, so it keeps starting Copilot CLI, opencode installed or not. A
# config.toml without a client line, what an existing user has, means copilot.
# A command that creates config.toml writes the client this machine runs now,
# so creating the file never switches a client.

fake-bin cplt copilot opencode

mkdir plattform/skills repo
cd plattform
exec git init -q .
exec git add -A
exec git -c user.email=e2e@example.test -c user.name=e2e commit -qm innhold
cd ../repo
exec git init -q .
exec nav-pilot install plattform --source $WORK/plattform --user --yes
! exists $HOME/config.toml

# Headless, no config.toml, opencode installed: Copilot CLI, and nothing said.
exec nav-pilot --source $WORK/plattform -- -p hei
! stderr 'opencode'
grep '^--agent\ncopilot\n' $WORK/fake/cplt.log
! exists $HOME/config.toml

# An existing user's config.toml without client: copilot, even with opencode there.
exec nav-pilot config set source $WORK/plattform
grep '^client = "copilot"' $HOME/config.toml
exec nav-pilot config unset client
! grep '^client' $HOME/config.toml
rm $WORK/fake/cplt.log
exec nav-pilot -- -p hei
grep '^--agent\ncopilot\n' $WORK/fake/cplt.log
exec nav-pilot config get client
stdout '^copilot$'

# In a terminal on a new install, creating config.toml writes opencode.
[!pty] stop 'no pseudo-terminal here (/dev/ptmx will not open)'
rm $HOME/config.toml
exec pty-run -- nav-pilot config set source $WORK/plattform
grep '^client = "opencode"' $HOME/config.toml
rm $HOME/config.toml
exec pty-run -- nav-pilot config set version 1
grep '^client = "opencode"' $HOME/config.toml
grep '^version = 1' $HOME/config.toml

-- plattform/.nav-pilot/agentpakke.json --
{"contractVersion":"1","name":"plattform","description":"plattform","layout":{"agents":"agents","skills":"skills"},"clients":{"copilot":{"primaryAgents":["grillmester"]},"opencode":{"primaryAgents":["grillmester"]}}}
-- plattform/agents/grillmester.agent.md --
---
name: grillmester
description: fra plattform
---
plattform
