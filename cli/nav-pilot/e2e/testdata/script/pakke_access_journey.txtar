# One home for the agentpakke (#1962): decline the access it asks for at
# install, see the decline in `nav-pilot pakke` and doctor, then grant it with
# `nav-pilot pakke access`, after which both are quiet about it.

[!pty] skip 'no pseudo-terminal here (/dev/ptmx will not open)'

# The question is about cplt's settings, so it needs cplt on PATH (#1189).
fake-bin cplt copilot

mkdir plattform/skills repo
cd plattform
exec git init -q .
exec git add -A
exec git -c user.email=e2e@example.test -c user.name=e2e commit -qm innhold
cd ../repo
exec git init -q .

# Enter declines.
exits 0 pty-run -wait 'Decline' -send '\r' -- nav-pilot install plattform --source $WORK/plattform --repo --yes
stdout 'Declined, so the agent can.t read Nais logs and metrics'

exec nav-pilot pakke
stdout 'agentpakke plattform \(repo\)'
stdout 'Source: .*plattform@'
stdout '1 agents:'
stdout 'Access: +read Nais logs and metrics: declined'
stdout -count=1 'Next: nav-pilot pakke access'

exits 0 nav-pilot doctor
stdout -count=1 '1 access declined: run nav-pilot pakke access'

# Without a terminal it says what it would ask, and fails.
! exec nav-pilot pakke access
stdout 'Would ask: Let the agent read Nais logs and metrics\? \(declined\)'

# The same question as first run; y allows.
exits 0 pty-run -wait 'Let the agent read Nais logs and metrics' -send 'y' -- nav-pilot pakke access
stdout 'plattform may'

exec nav-pilot pakke
stdout 'Access: +read Nais logs and metrics: granted'
! stdout 'Next:'

exec nav-pilot pakke access
stdout 'All access the agentpakke proposes is granted\.'

exits 0 nav-pilot doctor
! stdout 'access declined'

-- plattform/.nav-pilot/agentpakke.json --
{"contractVersion":"1","name":"plattform","description":"plattform","layout":{"agents":"agents","skills":"skills"},"clients":{"copilot":{"primaryAgents":["grillmester"]}},"policies":{"propose":{"cplt":{"reason":"The observability skill queries Mimir and Loki.","proxy":{"allow_private_domains":["loki.nav.cloud.nais.io","mimir.nav.cloud.nais.io"]}}}}}
-- plattform/agents/grillmester.agent.md --
---
name: grillmester
description: fra plattform
---
plattform
-- plattform/skills/brann/SKILL.md --
---
name: brann
description: fra plattform
---
brann
