# #1022: the first-run wizard preselects opencode on a new install. With
# opencode on PATH, Enter saves it. Without it, the wizard offers to install it,
# through Homebrew or else opencode's own script (yes installs, no saves
# copilot and says how to switch, naming both clients when neither is there).
# It never saves a client that cannot start.

[!pty] skip 'no pseudo-terminal here (/dev/ptmx will not open)'

# opencode installed.
fake-bin cplt copilot opencode
exits 130 pty-run -wait 'Which coding agent' -send '\r' -wait 'Conversation mode' -send '\x03' -- nav-pilot config setup
stdout 'OpenCode \(default\)'
! stdout 'opencode is not installed'

exits 0 pty-run -wait 'Which coding agent' -send '\r' -wait 'Conversation mode' -send '\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\r' -- nav-pilot config setup
grep '^client = "opencode"' home/config.toml

# No opencode, no Homebrew: opencode's own installer is offered. Declined,
# with copilot installed: copilot, and how to switch later.
rm home/config.toml
rm $WORK/fake/opencode
fake-bin cplt copilot
exits 0 pty-run -wait 'Which coding agent' -send '\r' -wait 'Install it now' -send '\x1b[C\r' -wait 'Conversation mode' -send '\r' -wait 'without asking' -send '\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\r' -- nav-pilot config setup
stdout 'Runs curl -fsSL https://opencode\.ai/install \| bash -s -- --version 1\.18\.32'
stdout 'opencode is not installed, so nav-pilot will use GitHub Copilot\. To switch later, install opencode \(curl -fsSL https://opencode\.ai/install \| bash -s -- --version 1\.18\.32\), then run nav-pilot config set client opencode'
grep '^client = "copilot"' home/config.toml

# Declined with neither client installed: both install commands (#1184).
rm home/config.toml
rm $WORK/fake/copilot
rm $WORK/fake/cplt
exits 0 pty-run -wait 'Which coding agent' -send '\r' -wait 'Install it now' -send '\x1b[C\r' -wait 'Conversation mode' -send '\r' -wait 'without asking' -send '\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\r' -- nav-pilot config setup
stdout 'Neither opencode nor GitHub Copilot is installed'
stdout 'opencode: curl -fsSL https://opencode\.ai/install \| bash -s -- --version 1\.18\.32, then nav-pilot config set client opencode'
stdout 'GitHub Copilot CLI: curl -fsSL https://gh\.io/copilot-install \| bash'

# Accepted without Homebrew: the script runs, and opencode in
# ~/.opencode/bin is found in the same run and saved (#1184).
rm home/config.toml
fake-bin cplt copilot bash
cp bash.sh $WORK/fake/bash.sh
exits 0 pty-run -wait 'Which coding agent' -send '\r' -wait 'Install it now' -send '\r' -wait 'Conversation mode' -send '\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\r' -- nav-pilot config setup
grep '^-c\ncurl -fsSL https://opencode.ai/install \| bash -s -- --version 1\.18\.32\n---' $WORK/fake/bash.log
stdout 'opencode installed'
grep '^client = "opencode"' home/config.toml
rm $WORK/fake/bash
rm $WORK/fake/bash.sh

# No opencode, Homebrew there, the offer declined: copilot.
rm home/config.toml
fake-bin cplt copilot brew
exits 0 pty-run -wait 'Which coding agent' -send '\r' -wait 'Install it now' -send '\x1b[C\r' -wait 'Conversation mode' -send '\r' -wait 'without asking' -send '\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\r' -- nav-pilot config setup
stdout 'Runs brew install anomalyco/tap/opencode'
! exists $WORK/fake/brew.log
grep '^client = "copilot"' home/config.toml

# Accepted: brew installs opencode, and the wizard saves it.
rm home/config.toml
cp brew.sh $WORK/fake/brew.sh
exits 0 pty-run -wait 'Which coding agent' -send '\r' -wait 'Install it now' -send '\r' -wait 'Conversation mode' -send '\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\r' -- nav-pilot config setup
grep '^install\nanomalyco/tap/opencode\n---' $WORK/fake/brew.log
stdout 'opencode installed'
grep '^client = "opencode"' home/config.toml

-- bash.sh --
/bin/mkdir -p "$HOME/.opencode/bin" && /bin/cp "$WORK/fake/copilot" "$HOME/.opencode/bin/opencode"
-- brew.sh --
/bin/cp "$WORK/fake/copilot" "$WORK/fake/opencode"
