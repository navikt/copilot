# After an interactive session, and only in a terminal, nav-pilot asks about
# an open survey, says what is sent before any question, and sends the
# answers with the GitHub sign-in. The payload is the answers and four enums:
# no device id, nothing from the session. A second answer to the same survey
# is refused by copilot-cli and said so plainly. An optional choice starts on
# Skip.

[!pty] skip 'no pseudo-terminal here (/dev/ptmx will not open)'

env NAV_PILOT_TELEMETRY_ENABLED=true
env DO_NOT_TRACK=
env NAV_PILOT_TELEMETRY_ENDPOINT=http://127.0.0.1:9/v1/metrics
env NAV_PILOT_E2E_GITHUB_TOKEN=gho_e2e
fake-survey
fake-bin cplt copilot

mkdir plattform/skills repo
cd plattform
exec git init -q .
exec git add -A
exec git -c user.email=e2e@example.test -c user.name=e2e commit -qm innhold
cd ../repo
exec git init -q .
exec nav-pilot install plattform --source $WORK/plattform --repo --yes
exec nav-pilot config set rtk_prompted_client copilot

# No terminal: no survey, and copilot-cli is not even asked.
exec nav-pilot -- -p hei
! stdout 'Brukerundersøkelse'
! exists $WORK/survey-gets.log

# Terminal: the session ends, then the question, with what is sent. Enter
# alone means later; answering takes a step up.
exec pty-run -wait 'Brukerundersøkelse: E2E survey \(4 spørsmål, spurt 1 av 3 ganger\)' -send '\x1b[A\r' -wait '4  Enig' -send '\x1b[B\x1b[B\x1b[B\r' -wait 'Velg opptil 2' -send ' \r' -wait 'Anything else' -send 'works fine\r' -- nav-pilot
stdout 'Dette sendes: svarene dine, nav-pilot-versjon, operativsystem'
stdout 'Dette sendes ikke: navn, GitHub-bruker, enhets-ID, kode eller noe fra øktene dine'
stdout 'kan ikke endres eller trekkes'
stdout 'Skriv ikke noe som kan identifisere deg eller andre'
! stdout 'Why not copilot'
stdout 'Takk! Svaret ditt er sendt'
grep -count=1 '^POST 201 bearer=true keys=answers,context context=client,local_models,os,version device_id_leak=no ' $WORK/survey-posts.log
grep '"answers":\{"clients":\["copilot"\],"comment":"works fine","useful":4\}' $WORK/survey-posts.log
grep '"client":"copilot","local_models":false' $WORK/survey-posts.log
! grep 'hei|repo|plattform|e2e@example' $WORK/survey-posts.log

# Answered: never asked again.
exec pty-run -- nav-pilot
! stdout 'Brukerundersøkelse'

# The same person again, from a fresh machine state: copilot-cli says 409.
rm $HOME/surveys.json
exec pty-run -wait 'Brukerundersøkelse' -send '\x1b[A\r' -wait 'How useful' -send '\r' -wait 'Velg opptil 2' -send '\x1b[B \r' -wait 'Why not copilot' -send '\x1b[A\x1b[A\r' -wait 'Anything else' -send '\r' -- nav-pilot
stdout 'Du har allerede svart på denne undersøkelsen, så dette svaret ble ikke sendt'
grep -count=1 '^POST 409 .*"clients":\["opencode"\].*"why":"habit"' $WORK/survey-posts.log

-- home/device-id --
nav-pilot-0123456789ab
-- plattform/.nav-pilot/agentpakke.json --
{"contractVersion":"1","name":"plattform","description":"plattform","layout":{"agents":"agents","skills":"skills"},"clients":{"copilot":{"primaryAgents":["grillmester"]}}}
-- plattform/agents/grillmester.agent.md --
---
name: grillmester
description: fra plattform
---
plattform
