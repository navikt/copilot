# #1348: the wizard asks two separate questions, how Copilot runs commands
# (nav-pilot's autonomy) and what the agent may do with git (cplt's
# git_guard.protect_default_branch_only). Each starts on today's value, only
# what differs is written, a summary comes first, and Cancel there writes
# nothing. The network question is only in --advanced. The gh check runs
# after the save and names the command to run.

[!pty] skip 'no pseudo-terminal here (/dev/ptmx will not open)'

fake-bin cplt copilot
cp cplt.sh $WORK/fake/cplt.sh

# 1. Enter on both: autonomy = sandbox, marked as chosen; cplt is already on
# standard with pushes, so nothing is set there.
exits 0 pty-run -wait 'Which coding agent' -send '\x1b[B\r' -wait 'Conversation mode' -send '\r' -wait 'run commands' -send '\r' -wait 'do with git' -send '\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\r' -wait 'Save these settings' -send '\r' -- nav-pilot config setup
stdout 'On its own inside the sandbox, and ask you when it needs to \(recommended\)'
stdout 'Commit, push branches and open pull requests \(recommended\)'
stdout 'cplt never lets it push to main or merge'
! stdout 'Network'
stdout 'nav-pilot autonomy = sandbox'
stdout 'cplt: no changes'
grep 'autonomy = "sandbox"' home/config.toml
! grep 'config\nset' $WORK/fake/cplt.log
stdout 'gh is not installed; the agent needs it to open PRs'

# Enter all the way again changes nothing.
cp home/config.toml before.toml
exits 0 pty-run -wait 'Which coding agent' -send '\r' -wait 'Conversation mode' -send '\r' -wait 'run commands' -send '\r' -wait 'do with git' -send '\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\r' -wait 'Save these settings' -send '\r' -- nav-pilot config setup --force
cmp home/config.toml before.toml
! grep 'config\nset' $WORK/fake/cplt.log

# 2. Ask before each command: written with the mark that it was chosen.
exits 0 pty-run -wait 'Which coding agent' -send '\r' -wait 'Conversation mode' -send '\r' -wait 'run commands' -send '\x1b[B\r' -wait 'do with git' -send '\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\r' -wait 'Save these settings' -send '\r' -- nav-pilot config setup --force
stdout 'nav-pilot autonomy = conservative'
grep 'autonomy = "conservative"' home/config.toml
grep 'autonomy_chosen = true' home/config.toml
! grep 'config\nset' $WORK/fake/cplt.log

# The rerun starts on it: Enter keeps it byte for byte.
cp home/config.toml before.toml
exits 0 pty-run -wait 'Which coding agent' -send '\r' -wait 'Conversation mode' -send '\r' -wait 'run commands' -send '\r' -wait 'do with git' -send '\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\r' -wait 'Save these settings' -send '\r' -- nav-pilot config setup --force
cmp home/config.toml before.toml

# Cancel at the summary: neither config changes.
exits 0 pty-run -wait 'Which coding agent' -send '\r' -wait 'Conversation mode' -send '\r' -wait 'run commands' -send '\x1b[A\r' -wait 'do with git' -send '\x1b[B\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\r' -wait 'Save these settings' -send '\x1b[C\r' -- nav-pilot config setup --force
stdout 'Nothing saved'
cmp home/config.toml before.toml
! grep 'config\nset' $WORK/fake/cplt.log

# 3. Commit only (no pushes): the one cplt key, and not the preset.
exits 0 pty-run -wait 'Which coding agent' -send '\r' -wait 'Conversation mode' -send '\r' -wait 'run commands' -send '\r' -wait 'do with git' -send '\x1b[B\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\r' -wait 'Save these settings' -send '\r' -- nav-pilot config setup --force
stdout 'cplt git_guard.protect_default_branch_only: unset → false'
stdout 'The agent cannot push at all'
grep 'config\nset\ngit_guard.protect_default_branch_only\nfalse\n---' $WORK/fake/cplt.log
! grep 'sandbox.preset\n(standard|strict)' $WORK/fake/cplt.log
cmp home/config.toml before.toml

# 4. --advanced adds the network question. Allowlist only (strict) starts
# the git question on strict's baseline, no pushes, and seeds the Nav hosts
# before it sets the preset.
rm $WORK/fake/cplt.log
exits 0 pty-run -wait 'Which coding agent' -send '\r' -wait 'Conversation mode' -send '\r' -wait 'run commands' -send '\r' -wait 'Network' -send '\x1b[B\r' -wait 'do with git' -send '\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\r' -wait 'Save these settings' -send '\r' -- nav-pilot config setup --force --advanced
stdout 'cplt sandbox.preset: standard → strict'
stdout 'The agent cannot push at all'
grep 'config\nset\nproxy.allowed_domains\n.*\n---\nconfig\nset\nsandbox.preset\nstrict\n---' $WORK/fake/cplt.log
! grep 'set\ngit_guard' $WORK/fake/cplt.log

# --advanced is a config setup flag only.
! exec nav-pilot doctor --advanced
stderr 'unknown flag --advanced'
! exec nav-pilot config get setup --advanced
stderr 'unknown flag --advanced'

# A repo with tooling and no .cplt.toml: the wizard offers cplt init --write
# and points to cplt trust accept, which it never runs.
mkdir repo/.git
cd repo
rm $WORK/fake/cplt.log
exits 0 pty-run -wait 'Which coding agent' -send '\r' -wait 'Conversation mode' -send '\r' -wait 'run commands' -send '\r' -wait 'do with git' -send '\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\r' -wait 'Save these settings' -send '\r' -wait 'Apply the suggested sandbox rules' -send '\r' -- nav-pilot config setup --force
stdout 'Detected: JVM \(Gradle\)'
grep 'init\n--write\n---' $WORK/fake/cplt.log
! grep 'trust' $WORK/fake/cplt.log
stdout 'git add :/.cplt.toml'
stdout 'git commit -m .* -- :/.cplt.toml'
stdout 'cplt trust accept'
cd $WORK

# 5. Under cplt permissive there is no git question (its guard is off), and
# the summary says nothing is blocked. cplt is not written.
cp permissive.txt $WORK/fake/preset
rm $WORK/fake/cplt.log
exits 0 pty-run -wait 'Which coding agent' -send '\r' -wait 'Conversation mode' -send '\r' -wait 'run commands' -send '\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\r' -wait 'Save these settings' -send '\r' -- nav-pilot config setup --force
! stdout 'do with git'
stdout 'guards are off, so nothing is blocked'
! stdout 'cannot push at all'
! grep 'config\nset' $WORK/fake/cplt.log
rm $WORK/fake/preset

# 6. opencode does not read autonomy: no client question, and the git
# question says opencode keeps its own permission settings.
fake-bin cplt copilot opencode
cp cplt.sh $WORK/fake/cplt.sh
rm home/config.toml
exits 0 pty-run -wait 'Which coding agent' -send '\r' -wait 'Conversation mode' -send '\r' -wait 'do with git' -send '\r' -wait 'Model' -send '\r' -wait 'Reasoning effort' -send '\r' -wait 'Auto-update' -send '\r' -wait 'Save these settings' -send '\r' -- nav-pilot config setup
! stdout 'run commands'
stdout 'keeps its own permission settings'
grep 'client = "opencode"' home/config.toml
! grep 'autonomy' home/config.toml

# Non-TTY: no prompt, no write.
rm $WORK/fake/cplt.log
! exec nav-pilot config setup --force
stderr 'config setup needs a terminal'
! exists $WORK/fake/cplt.log

-- cplt.sh --
# Answers config get like cplt does for keys the file does not set: the
# value on stdout, the "(default" marker on stderr.
if [ "$1 $2" = "config get" ]; then
  case "$3" in
    sandbox.preset)
      if [ -f "$WORK/fake/preset" ]; then read p < "$WORK/fake/preset"; echo "$p"
      else echo standard; echo '[cplt] (default, not set in config file)' >&2; fi ;;
    git_guard.protect_default_branch_only) echo true; echo '[cplt] (default, not set in config file)' >&2 ;;
  esac
  exit 0
fi
if [ "$1 $2" = "init -q" ]; then
  printf '# Generated by `cplt init`. Review before trusting.\n# Detected: JVM (Gradle)\n\n[propose]\nallow_jvm_attach = true\n'
fi
-- permissive.txt --
permissive
