--- a/app/api/saker/route.ts
+++ b/app/api/saker/route.ts
@@ -1,5 +1,30 @@
-import { listSaker } from "../../../lib/saker.ts";
+import { createSak, listSaker, type Sak } from "../../../lib/saker.ts";
 
 export async function GET(): Promise<Response> {
   return Response.json(listSaker());
 }
+
+export async function POST(request: Request): Promise<Response> {
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return Response.json({ error: "Ugyldig JSON" }, { status: 400 });
+  }
+
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return Response.json({ error: "Ugyldig forespørsel" }, { status: 400 });
+  }
+
+  const { tittel, prioritet } = body as Record<string, unknown>;
+  if (typeof tittel !== "string" || tittel.trim().length === 0) {
+    return Response.json({ error: "Tittel må fylles ut" }, { status: 400 });
+  }
+  if (prioritet !== undefined && prioritet !== "normal" && prioritet !== "hoy") {
+    return Response.json({ error: "Ugyldig prioritet" }, { status: 400 });
+  }
+
+  const sakPrioritet: Sak["prioritet"] = prioritet === "hoy" ? "hoy" : "normal";
+  const sak = createSak(tittel.trim(), sakPrioritet);
+  return Response.json(sak, { status: 201 });
+}
--- a/lib/saker.ts
+++ b/lib/saker.ts
@@ -5,3 +5,13 @@
 export function listSaker(): Sak[] {
   return [...saker];
 }
+
+export function createSak(tittel: string, prioritet: Sak["prioritet"]): Sak {
+  const sak: Sak = {
+    id: Math.max(...saker.map((existingSak) => existingSak.id)) + 1,
+    tittel,
+    prioritet,
+  };
+  saker.push(sak);
+  return sak;
+}
