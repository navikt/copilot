@@ -1,9 +1,57 @@
 import assert from "node:assert/strict";
 import { test } from "node:test";
-import { GET } from "../app/api/saker/route.ts";
+import { GET, POST } from "../app/api/saker/route.ts";
 
 test("existing cases remain visible", async () => {
   const response = await GET();
   assert.equal(response.status, 200);
   assert.ok((await response.json()).some((sak: { id: number }) => sak.id === 101));
 });
+
+function sakRequest(body: unknown): Request {
+  return new Request("http://localhost/api/saker", {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(body),
+  });
+}
+
+test("creates cases with new IDs and shows them in the overview", async () => {
+  const normal = await POST(sakRequest({ tittel: "Ny sak" }));
+  assert.equal(normal.status, 201);
+  const normalSak = await normal.json();
+  assert.deepEqual(normalSak, { id: 102, tittel: "Ny sak", prioritet: "normal" });
+
+  const hoy = await POST(sakRequest({ tittel: "Haster", prioritet: "hoy" }));
+  assert.equal(hoy.status, 201);
+  const hoySak = await hoy.json();
+  assert.deepEqual(hoySak, { id: 103, tittel: "Haster", prioritet: "hoy" });
+
+  const oversikt = await GET();
+  assert.deepEqual((await oversikt.json()).slice(-2), [normalSak, hoySak]);
+});
+
+test("rejects invalid cases without creating them", async () => {
+  const before = await (await GET()).json();
+  for (const body of [
+    {},
+    { tittel: "" },
+    { tittel: " \t " },
+    { tittel: null },
+    { tittel: "Sak", prioritet: "lav" },
+    { tittel: "Sak", prioritet: null },
+    null,
+    [],
+  ]) {
+    const response = await POST(sakRequest(body));
+    assert.equal(response.status, 400);
+    assert.equal(response.headers.get("Content-Type"), "application/problem+json");
+    assert.equal((await response.json()).status, 400);
+  }
+  const malformed = await POST(new Request("http://localhost/api/saker", {
+    method: "POST",
+    body: "{",
+  }));
+  assert.equal(malformed.status, 400);
+  assert.deepEqual(await (await GET()).json(), before);
+});
