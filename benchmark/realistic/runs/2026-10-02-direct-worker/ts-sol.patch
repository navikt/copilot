--- a/app/api/saker/route.ts
+++ b/app/api/saker/route.ts
@@ -1,5 +1,37 @@
-import { listSaker } from "../../../lib/saker.ts";
+import { listSaker, opprettSak } from "../../../lib/saker.ts";
 
 export async function GET(): Promise<Response> {
   return Response.json(listSaker());
 }
+
+function ugyldigForesporsel(detail: string): Response {
+  return Response.json(
+    { type: "about:blank", title: "Ugyldig forespørsel", status: 400, detail },
+    { status: 400, headers: { "Content-Type": "application/problem+json" } },
+  );
+}
+
+export async function POST(request: Request): Promise<Response> {
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch (error) {
+    if (error instanceof SyntaxError) {
+      return ugyldigForesporsel("Forespørselen må inneholde gyldig JSON.");
+    }
+    throw error;
+  }
+
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return ugyldigForesporsel("Forespørselen må inneholde en sak.");
+  }
+  if (!("tittel" in body) || typeof body.tittel !== "string" || !body.tittel.trim()) {
+    return ugyldigForesporsel("Tittel må fylles ut.");
+  }
+  const prioritet = "prioritet" in body ? body.prioritet : "normal";
+  if (prioritet !== "normal" && prioritet !== "hoy") {
+    return ugyldigForesporsel("Prioritet må være normal eller hoy.");
+  }
+
+  return Response.json(opprettSak(body.tittel, prioritet), { status: 201 });
+}
--- a/lib/saker.ts
+++ b/lib/saker.ts
@@ -1,7 +1,14 @@
 export type Sak = { id: number; tittel: string; prioritet: "normal" | "hoy" };
 
 const saker: Sak[] = [{ id: 101, tittel: "Eksisterende sak", prioritet: "normal" }];
+let nesteId = Math.max(...saker.map((sak) => sak.id)) + 1;
 
 export function listSaker(): Sak[] {
   return [...saker];
 }
+
+export function opprettSak(tittel: string, prioritet: Sak["prioritet"]): Sak {
+  const sak: Sak = { id: nesteId++, tittel, prioritet };
+  saker.push(sak);
+  return sak;
+}
