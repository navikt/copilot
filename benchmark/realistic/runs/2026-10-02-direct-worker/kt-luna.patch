+    @Test
+    fun completesTaskIdempotentlyAndUpdatesGets() = testApplication {
+        application { taskModule() }
+
+        val firstCompletion = client.post("/tasks/1/complete")
+        assertEquals(HttpStatusCode.OK, firstCompletion.status)
+        assertEquals("1:Review request:done", firstCompletion.bodyAsText())
+
+        val secondCompletion = client.post("/tasks/1/complete")
+        assertEquals(HttpStatusCode.OK, secondCompletion.status)
+        assertEquals("1:Review request:done", secondCompletion.bodyAsText())
+
+        assertEquals("1:Review request:done", client.get("/tasks/1").bodyAsText())
+        assertEquals(
+            "1:Review request:done\n2:Send response:open",
+            client.get("/tasks").bodyAsText()
+        )
+    }
+
+    @Test
