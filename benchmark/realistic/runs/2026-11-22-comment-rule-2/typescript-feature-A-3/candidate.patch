diff --git a/app/api/saker/route.ts b/app/api/saker/route.ts
index 75013e6..3360310 100644
--- a/app/api/saker/route.ts
+++ b/app/api/saker/route.ts
@@ -1,6 +1,30 @@
-import { listSaker } from "../../../lib/saker.ts";
+import { createSak, listSaker, type Sak } from "../../../lib/saker.ts";
 
-// Read-only endpoint: this route only supports GET.
 export async function GET(): Promise<Response> {
   return Response.json(listSaker());
 }
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+export async function POST(request: Request): Promise<Response> {
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return Response.json({ error: "Ugyldig forespørsel" }, { status: 400 });
+  }
+
+  if (!isRecord(body) || typeof body.tittel !== "string" || body.tittel.trim() === "") {
+    return Response.json({ error: "Tittel må fylles ut" }, { status: 400 });
+  }
+
+  const prioritet = body.prioritet === undefined ? "normal" : body.prioritet;
+  if (prioritet !== "normal" && prioritet !== "hoy") {
+    return Response.json({ error: "Ugyldig prioritet" }, { status: 400 });
+  }
+
+  const sak: Sak = createSak(body.tittel.trim(), prioritet);
+  return Response.json(sak, { status: 201 });
+}
diff --git a/lib/saker.ts b/lib/saker.ts
index 0d7e8ba..45a8bfe 100644
--- a/lib/saker.ts
+++ b/lib/saker.ts
@@ -1,9 +1,15 @@
 export type Sak = { id: number; tittel: string; prioritet: "normal" | "hoy" };
 
-// Fixed seed list: saker are never added at runtime.
+// In-memory case list, initialized with one example case.
 const saker: Sak[] = [{ id: 101, tittel: "Eksisterende sak", prioritet: "normal" }];
+let nextId = 102;
 
-// Returns the seed list; nothing else can modify it.
 export function listSaker(): Sak[] {
   return [...saker];
 }
+
+export function createSak(tittel: string, prioritet: Sak["prioritet"] = "normal"): Sak {
+  const sak = { id: nextId++, tittel, prioritet };
+  saker.push(sak);
+  return sak;
+}
diff --git a/tests/regression.test.ts b/tests/regression.test.ts
index 31d829e..89f9ea7 100644
--- a/tests/regression.test.ts
+++ b/tests/regression.test.ts
@@ -1,9 +1,59 @@
 import assert from "node:assert/strict";
 import { test } from "node:test";
-import { GET } from "../app/api/saker/route.ts";
+import { GET, POST } from "../app/api/saker/route.ts";
 
 test("existing cases remain visible", async () => {
   const response = await GET();
   assert.equal(response.status, 200);
   assert.ok((await response.json()).some((sak: { id: number }) => sak.id === 101));
 });
+
+test("creates a case and makes it visible in the overview", async () => {
+  const response = await POST(
+    new Request("http://localhost/api/saker", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ tittel: "Ny sak", prioritet: "hoy" }),
+    }),
+  );
+  const sak = await response.json();
+
+  assert.equal(response.status, 201);
+  assert.deepEqual(sak, { id: 102, tittel: "Ny sak", prioritet: "hoy" });
+  assert.ok((await (await GET()).json()).some((item: { id: number }) => item.id === sak.id));
+});
+
+test("defaults priority to normal", async () => {
+  const response = await POST(
+    new Request("http://localhost/api/saker", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ tittel: "Sak uten prioritet" }),
+    }),
+  );
+
+  assert.equal(response.status, 201);
+  assert.equal((await response.json()).prioritet, "normal");
+});
+
+test("rejects invalid input without creating a case", async () => {
+  const invalidBodies = [
+    {},
+    { tittel: "   " },
+    { tittel: "Ugyldig prioritet", prioritet: "lav" },
+  ];
+
+  for (const body of invalidBodies) {
+    const before = (await (await GET()).json()).length;
+    const response = await POST(
+      new Request("http://localhost/api/saker", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify(body),
+      }),
+    );
+
+    assert.equal(response.status, 400);
+    assert.equal((await (await GET()).json()).length, before);
+  }
+});
