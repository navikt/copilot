diff --git a/app/api/saker/route.ts b/app/api/saker/route.ts
index 75013e6..734863c 100644
--- a/app/api/saker/route.ts
+++ b/app/api/saker/route.ts
@@ -1,6 +1,33 @@
-import { listSaker } from "../../../lib/saker.ts";
+import { createSak, listSaker } from "../../../lib/saker.ts";
 
-// Read-only endpoint: this route only supports GET.
 export async function GET(): Promise<Response> {
   return Response.json(listSaker());
 }
+
+export async function POST(request: Request): Promise<Response> {
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return Response.json({ error: "Ugyldig forespørsel" }, { status: 400 });
+  }
+
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return Response.json({ error: "Ugyldig forespørsel" }, { status: 400 });
+  }
+
+  const { tittel, prioritet } = body as {
+    tittel?: unknown;
+    prioritet?: unknown;
+  };
+  if (
+    typeof tittel !== "string" ||
+    tittel.trim() === "" ||
+    (prioritet !== undefined && prioritet !== "normal" && prioritet !== "hoy")
+  ) {
+    return Response.json({ error: "Ugyldig forespørsel" }, { status: 400 });
+  }
+
+  const sak = createSak(tittel, prioritet);
+  return Response.json(sak, { status: 201 });
+}
diff --git a/lib/saker.ts b/lib/saker.ts
index 0d7e8ba..eaf4035 100644
--- a/lib/saker.ts
+++ b/lib/saker.ts
@@ -1,9 +1,17 @@
 export type Sak = { id: number; tittel: string; prioritet: "normal" | "hoy" };
 
-// Fixed seed list: saker are never added at runtime.
 const saker: Sak[] = [{ id: 101, tittel: "Eksisterende sak", prioritet: "normal" }];
+let nextId = 102;
 
-// Returns the seed list; nothing else can modify it.
 export function listSaker(): Sak[] {
   return [...saker];
 }
+
+export function createSak(
+  tittel: string,
+  prioritet: Sak["prioritet"] = "normal",
+): Sak {
+  const sak: Sak = { id: nextId++, tittel, prioritet };
+  saker.push(sak);
+  return sak;
+}
diff --git a/tests/regression.test.ts b/tests/regression.test.ts
index 31d829e..3641994 100644
--- a/tests/regression.test.ts
+++ b/tests/regression.test.ts
@@ -1,9 +1,59 @@
 import assert from "node:assert/strict";
 import { test } from "node:test";
-import { GET } from "../app/api/saker/route.ts";
+import { GET, POST } from "../app/api/saker/route.ts";
 
 test("existing cases remain visible", async () => {
   const response = await GET();
   assert.equal(response.status, 200);
   assert.ok((await response.json()).some((sak: { id: number }) => sak.id === 101));
 });
+
+test("creates cases with default and specified priority and lists them", async () => {
+  const normalResponse = await POST(
+    new Request("http://localhost/api/saker", {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ tittel: "Ny normal sak" }),
+    }),
+  );
+  assert.equal(normalResponse.status, 201);
+  const normalSak = await normalResponse.json();
+  assert.deepEqual(normalSak, {
+    id: 102,
+    tittel: "Ny normal sak",
+    prioritet: "normal",
+  });
+
+  const highResponse = await POST(
+    new Request("http://localhost/api/saker", {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ tittel: "Ny sak", prioritet: "hoy" }),
+    }),
+  );
+  assert.equal(highResponse.status, 201);
+  const highSak = await highResponse.json();
+  assert.equal(highSak.prioritet, "hoy");
+  assert.ok((await (await GET()).json()).some((sak: { id: number }) => sak.id === highSak.id));
+});
+
+test("rejects invalid input without creating a case", async () => {
+  const initialCount = (await (await GET()).json()).length;
+  for (const body of [
+    {},
+    { tittel: "" },
+    { tittel: "   " },
+    { tittel: "Ugyldig prioritet", prioritet: "lav" },
+    { tittel: "Null prioritet", prioritet: null },
+  ]) {
+    const response = await POST(
+      new Request("http://localhost/api/saker", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify(body),
+      }),
+    );
+    assert.equal(response.status, 400);
+  }
+  assert.equal((await (await GET()).json()).length, initialCount);
+});
