--- a/app/api/saker/route.ts
+++ b/app/api/saker/route.ts
@@ -1,5 +1,31 @@
-import { listSaker } from "../../../lib/saker.ts";
+import { createSak, listSaker, type Prioritet } from "../../../lib/saker.ts";
 
 export async function GET(): Promise<Response> {
   return Response.json(listSaker());
 }
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+export async function POST(request: Request): Promise<Response> {
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return Response.json({ error: "Ugyldig JSON" }, { status: 400 });
+  }
+
+  if (!isRecord(body) || typeof body.tittel !== "string" || body.tittel.trim() === "") {
+    return Response.json({ error: "Tittel må fylles ut" }, { status: 400 });
+  }
+
+  const prioritet = body.prioritet;
+  if (prioritet !== undefined && prioritet !== "normal" && prioritet !== "hoy") {
+    return Response.json({ error: "Ugyldig prioritet" }, { status: 400 });
+  }
+
+  const sakPrioritet: Prioritet = prioritet === "hoy" ? "hoy" : "normal";
+  const sak = createSak(body.tittel, sakPrioritet);
+  return Response.json(sak, { status: 201 });
+}
diff --git a/lib/saker.ts b/lib/saker.ts
index 7af84b7..b77c4a0 100644
--- a/lib/saker.ts
+++ b/lib/saker.ts
@@ -1,7 +1,18 @@
-export type Sak = { id: number; tittel: string; prioritet: "normal" | "hoy" };
+export type Prioritet = "normal" | "hoy";
+export type Sak = { id: number; tittel: string; prioritet: Prioritet };
 
 const saker: Sak[] = [{ id: 101, tittel: "Eksisterende sak", prioritet: "normal" }];
 
 export function listSaker(): Sak[] {
   return [...saker];
 }
+
+export function createSak(tittel: string, prioritet: Prioritet = "normal"): Sak {
+  const sak: Sak = {
+    id: Math.max(...saker.map(({ id }) => id)) + 1,
+    tittel,
+    prioritet,
+  };
+  saker.push(sak);
+  return sak;
+}
