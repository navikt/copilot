diff --git a/app/api/saker/route.ts b/app/api/saker/route.ts
index f90fbb7..bcc0c1d 100644
--- a/app/api/saker/route.ts
+++ b/app/api/saker/route.ts
@@ -1,5 +1,33 @@
-import { listSaker } from "../../../lib/saker.ts";
+import { createSak, listSaker } from "../../../lib/saker.ts";
 
 export async function GET(): Promise<Response> {
   return Response.json(listSaker());
 }
+
+export async function POST(request: Request): Promise<Response> {
+  let payload: unknown;
+  try {
+    payload = await request.json();
+  } catch {
+    return Response.json({ error: "Ugyldig forespørsel" }, { status: 400 });
+  }
+
+  if (
+    typeof payload !== "object" ||
+    payload === null ||
+    Array.isArray(payload) ||
+    !("tittel" in payload) ||
+    typeof payload.tittel !== "string" ||
+    payload.tittel.trim() === ""
+  ) {
+    return Response.json({ error: "Tittel må fylles ut" }, { status: 400 });
+  }
+
+  const prioritet = "prioritet" in payload ? payload.prioritet : "normal";
+  if (prioritet !== "normal" && prioritet !== "hoy") {
+    return Response.json({ error: "Ugyldig prioritet" }, { status: 400 });
+  }
+
+  const sak = createSak(payload.tittel, prioritet);
+  return Response.json(sak, { status: 201 });
+}
diff --git a/lib/saker.ts b/lib/saker.ts
index 7af84b7..749d745 100644
--- a/lib/saker.ts
+++ b/lib/saker.ts
@@ -1,7 +1,14 @@
 export type Sak = { id: number; tittel: string; prioritet: "normal" | "hoy" };
 
 const saker: Sak[] = [{ id: 101, tittel: "Eksisterende sak", prioritet: "normal" }];
+let nesteId = saker.reduce((maxId, sak) => Math.max(maxId, sak.id), 0) + 1;
 
 export function listSaker(): Sak[] {
   return [...saker];
 }
+
+export function createSak(tittel: string, prioritet: Sak["prioritet"] = "normal"): Sak {
+  const sak = { id: nesteId++, tittel, prioritet };
+  saker.push(sak);
+  return sak;
+}
diff --git a/tests/regression.test.ts b/tests/regression.test.ts
index 31d829e..4309204 100644
--- a/tests/regression.test.ts
+++ b/tests/regression.test.ts
@@ -1,9 +1,64 @@
 import assert from "node:assert/strict";
 import { test } from "node:test";
-import { GET } from "../app/api/saker/route.ts";
+import { GET, POST } from "../app/api/saker/route.ts";
 
 test("existing cases remain visible", async () => {
   const response = await GET();
   assert.equal(response.status, 200);
   assert.ok((await response.json()).some((sak: { id: number }) => sak.id === 101));
 });
+
+test("POST creates a case with default priority and adds it to the overview", async () => {
+  const response = await POST(
+    new Request("http://localhost/api/saker", {
+      method: "POST",
+      body: JSON.stringify({ tittel: "Ny sak" }),
+    }),
+  );
+  const created = await response.json();
+
+  assert.equal(response.status, 201);
+  assert.deepEqual(created, { id: 102, tittel: "Ny sak", prioritet: "normal" });
+  const overview = await GET();
+  assert.ok((await overview.json()).some((sak: { id: number }) => sak.id === created.id));
+});
+
+test("POST creates a case with high priority", async () => {
+  const response = await POST(
+    new Request("http://localhost/api/saker", {
+      method: "POST",
+      body: JSON.stringify({ tittel: "Høy prioritet", prioritet: "hoy" }),
+    }),
+  );
+
+  assert.equal(response.status, 201);
+  assert.deepEqual(await response.json(), {
+    id: 103,
+    tittel: "Høy prioritet",
+    prioritet: "hoy",
+  });
+});
+
+test("POST rejects invalid input without adding a case", async () => {
+  const invalidBodies = [
+    {},
+    { tittel: "" },
+    { tittel: "   " },
+    { tittel: "Ugyldig prioritet", prioritet: "lav" },
+  ];
+
+  for (const body of invalidBodies) {
+    const before = await GET();
+    const beforeSaker = await before.json();
+    const response = await POST(
+      new Request("http://localhost/api/saker", {
+        method: "POST",
+        body: JSON.stringify(body),
+      }),
+    );
+
+    assert.equal(response.status, 400);
+    const after = await GET();
+    assert.deepEqual(await after.json(), beforeSaker);
+  }
+});
