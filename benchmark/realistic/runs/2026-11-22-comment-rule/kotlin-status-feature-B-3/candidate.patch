 package no.nav.benchmark
 
 import io.ktor.client.request.get
+import io.ktor.client.request.post
 import io.ktor.client.statement.bodyAsText
 import io.ktor.http.HttpStatusCode
 import io.ktor.server.testing.testApplication
@@ -19,4 +20,36 @@ class TaskRoutesTest {
         application { taskModule() }
         assertEquals(HttpStatusCode.NotFound, client.get("/tasks/99").status)
     }
+
+    @Test
+    fun completesTaskAndReturnsUpdatedStateEverywhere() = testApplication {
+        application { taskModule() }
+
+        val completion = client.post("/tasks/1/complete")
+        assertEquals(HttpStatusCode.OK, completion.status)
+        assertEquals("1:Review request:done", completion.bodyAsText())
+        assertEquals("1:Review request:done", client.get("/tasks/1").bodyAsText())
+        assertEquals(
+            "1:Review request:done\n2:Send response:open",
+            client.get("/tasks").bodyAsText()
+        )
+
+        val repeatedCompletion = client.post("/tasks/1/complete")
+        assertEquals(HttpStatusCode.OK, repeatedCompletion.status)
+        assertEquals("1:Review request:done", repeatedCompletion.bodyAsText())
+        assertEquals(
+            "1:Review request:done\n2:Send response:open",
+            client.get("/tasks").bodyAsText()
+        )
+    }
+
+    @Test
+    fun rejectsInvalidAndUnknownTaskIdsWhenCompleting() = testApplication {
+        application { taskModule() }
+
+        assertEquals(HttpStatusCode.BadRequest, client.post("/tasks/not-an-id/complete").status)
+        assertEquals(HttpStatusCode.BadRequest, client.post("/tasks/0/complete").status)
+        assertEquals(HttpStatusCode.BadRequest, client.post("/tasks/-1/complete").status)
+        assertEquals(HttpStatusCode.NotFound, client.post("/tasks/99/complete").status)
+    }
 }
