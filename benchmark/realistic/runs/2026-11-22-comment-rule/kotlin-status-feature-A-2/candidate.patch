+
+    @Test
+    fun completesTaskAndReturnsUpdatedTaskFromBothGetRoutes() = testApplication {
+        application { taskModule() }
+
+        val response = client.post("/tasks/1/complete")
+
+        assertEquals(HttpStatusCode.OK, response.status)
+        assertEquals("1:Review request:done", response.bodyAsText())
+        assertEquals("1:Review request:done", client.get("/tasks/1").bodyAsText())
+        assertEquals(
+            "1:Review request:done\n2:Send response:open",
+            client.get("/tasks").bodyAsText(),
+        )
+    }
+
+    @Test
+    fun completingTaskTwiceKeepsItsTitleAndDoesNotDuplicateIt() = testApplication {
+        application { taskModule() }
+
+        client.post("/tasks/1/complete")
+        val response = client.post("/tasks/1/complete")
+
+        assertEquals(HttpStatusCode.OK, response.status)
+        assertEquals("1:Review request:done", response.bodyAsText())
+        assertEquals(
+            "1:Review request:done\n2:Send response:open",
+            client.get("/tasks").bodyAsText(),
+        )
+    }
+
+    @Test
+    fun rejectsInvalidAndNonPositiveTaskIds() = testApplication {
+        application { taskModule() }
+
+        for (id in listOf("invalid", "0", "-1")) {
+            assertEquals(HttpStatusCode.BadRequest, client.post("/tasks/$id/complete").status)
+        }
+    }
+
+    @Test
+    fun returnsNotFoundWhenCompletingUnknownTask() = testApplication {
+        application { taskModule() }
+
+        assertEquals(HttpStatusCode.NotFound, client.post("/tasks/99/complete").status)
+    }
 }
