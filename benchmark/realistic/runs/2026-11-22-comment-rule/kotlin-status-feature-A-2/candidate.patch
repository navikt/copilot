diff --git a/src/main/kotlin/no/nav/benchmark/TaskRepository.kt b/src/main/kotlin/no/nav/benchmark/TaskRepository.kt
index ce1d295..18f788f 100644
--- a/src/main/kotlin/no/nav/benchmark/TaskRepository.kt
+++ b/src/main/kotlin/no/nav/benchmark/TaskRepository.kt
@@ -8,6 +8,12 @@ class TaskRepository {
     @Synchronized
     fun find(id: Int): Task? = tasks[id]
 
+    @Synchronized
+    fun complete(id: Int): Task? {
+        val task = tasks[id] ?: return null
+        return task.copy(status = "done").also { tasks[id] = it }
+    }
+
     @Synchronized
     fun all(): List<Task> = tasks.values.toList()
 }
