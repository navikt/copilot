diff --git a/app/api/saker/route.ts b/app/api/saker/route.ts
index f90fbb7..9f11d09 100644
--- a/app/api/saker/route.ts
+++ b/app/api/saker/route.ts
@@ -1,5 +1,32 @@
-import { listSaker } from "../../../lib/saker.ts";
+import { createSak, listSaker } from "../../../lib/saker.ts";
 
 export async function GET(): Promise<Response> {
   return Response.json(listSaker());
 }
+
+export async function POST(request: Request): Promise<Response> {
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch (error) {
+    if (error instanceof SyntaxError) {
+      return Response.json({ error: "Ugyldig JSON" }, { status: 400 });
+    }
+    throw error;
+  }
+
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return Response.json({ error: "Ugyldig sak" }, { status: 400 });
+  }
+
+  const { tittel, prioritet } = body as Record<string, unknown>;
+  if (typeof tittel !== "string" || tittel.trim() === "") {
+    return Response.json({ error: "Tittel må fylles ut" }, { status: 400 });
+  }
+  if (prioritet !== undefined && prioritet !== "normal" && prioritet !== "hoy") {
+    return Response.json({ error: "Ugyldig prioritet" }, { status: 400 });
+  }
+
+  const sak = createSak(tittel, prioritet ?? "normal");
+  return Response.json(sak, { status: 201 });
+}
diff --git a/lib/saker.ts b/lib/saker.ts
index 7af84b7..bb0ed86 100644
--- a/lib/saker.ts
+++ b/lib/saker.ts
@@ -1,7 +1,14 @@
 export type Sak = { id: number; tittel: string; prioritet: "normal" | "hoy" };
 
 const saker: Sak[] = [{ id: 101, tittel: "Eksisterende sak", prioritet: "normal" }];
+let nesteId = 102;
 
 export function listSaker(): Sak[] {
   return [...saker];
 }
+
+export function createSak(tittel: string, prioritet: Sak["prioritet"]): Sak {
+  const sak = { id: nesteId++, tittel, prioritet };
+  saker.push(sak);
+  return sak;
+}
diff --git a/tests/regression.test.ts b/tests/regression.test.ts
index 31d829e..e76fd51 100644
--- a/tests/regression.test.ts
+++ b/tests/regression.test.ts
@@ -1,9 +1,60 @@
 import assert from "node:assert/strict";
 import { test } from "node:test";
-import { GET } from "../app/api/saker/route.ts";
+import { GET, POST } from "../app/api/saker/route.ts";
 
 test("existing cases remain visible", async () => {
   const response = await GET();
   assert.equal(response.status, 200);
   assert.ok((await response.json()).some((sak: { id: number }) => sak.id === 101));
 });
+
+test("creates a case with default priority and lists it afterward", async () => {
+  const response = await POST(
+    new Request("http://localhost/api/saker", {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ tittel: "Ny sak" }),
+    }),
+  );
+  const sak = await response.json();
+
+  assert.equal(response.status, 201);
+  assert.deepEqual(sak, { id: 102, tittel: "Ny sak", prioritet: "normal" });
+  assert.ok((await (await GET()).json()).some((item: { id: number }) => item.id === sak.id));
+});
+
+test("creates a case with high priority", async () => {
+  const response = await POST(
+    new Request("http://localhost/api/saker", {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ tittel: "Haster", prioritet: "hoy" }),
+    }),
+  );
+
+  assert.equal(response.status, 201);
+  assert.deepEqual(await response.json(), { id: 103, tittel: "Haster", prioritet: "hoy" });
+});
+
+test("rejects invalid input without creating a case", async () => {
+  const invalidBodies = [
+    {},
+    { tittel: "" },
+    { tittel: "   " },
+    { tittel: "Ugyldig prioritet", prioritet: "lav" },
+  ];
+
+  for (const body of invalidBodies) {
+    const before = await GET();
+    const response = await POST(
+      new Request("http://localhost/api/saker", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify(body),
+      }),
+    );
+
+    assert.equal(response.status, 400);
+    assert.deepEqual(await (await GET()).json(), await before.json());
+  }
+});
