{
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "edit|create|str_replace|str_replace_editor|apply_patch|view",
        "command": "command -v python3 >/dev/null 2>&1 && python3 .github/hooks/ask-first-aria.py || exit 0",
        "timeoutSec": 5,
        "navPilot": "ask-first-aria"
      },
      {
        "type": "command",
        "matcher": "bash|shell|execute",
        "command": "command -v python3 >/dev/null 2>&1 && python3 .github/hooks/klarsprak-gate.py || exit 0",
        "timeoutSec": 5,
        "navPilot": "klarsprak-gate"
      }
    ]
  },
  "version": 1
}
