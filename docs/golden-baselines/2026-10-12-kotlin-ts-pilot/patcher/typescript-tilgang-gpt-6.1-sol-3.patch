 import assert from "node:assert/strict";
 import { test } from "node:test";
+import { validateToken } from "@navikt/oasis";
+import { exportJWK, generateKeyPair, SignJWT, type JWTPayload } from "jose";
 import { GET as isalive } from "../app/api/isalive/route.ts";
+import { GET as isready } from "../app/api/isready/route.ts";
 import { GET as saker } from "../app/api/saker/route.ts";
+import { GET as interneSaker } from "../app/api/intern/saker/route.ts";
+import { GET as internSak } from "../app/api/intern/saker/[id]/route.ts";
+import { finnInternSak, listInterneSaker, listSaker } from "../lib/saker.ts";
 
 test("isalive svarer uten token", async () => {
   assert.equal((await isalive()).status, 200);
 });
 
+test("isready svarer uten token", async () => {
+  assert.equal((await isready()).status, 200);
+});
+
 test("saker krever token", async () => {
   assert.equal((await saker(new Request("http://localhost/api/saker"))).status, 401);
+});
+
+test("saksrutene validerer tokenet uten proxy", async (t) => {
+  const { publicKey, privateKey } = await generateKeyPair("RS256");
+  const { privateKey: wrongKey } = await generateKeyPair("RS256");
+  const jwk = await exportJWK(publicKey);
+  const jwksUri = "https://jwks.example.test/keys";
+  t.mock.method(globalThis, "fetch", async (input: string | URL | Request) => {
+    assert.equal(String(input), jwksUri);
+    return Response.json({ keys: [{ ...jwk, kid: "test-key", alg: "RS256" }] });
+  });
+
+  const issuer = "https://issuer.example.test";
+  const audience = "saksoversikt-test";
+  const env: Record<string, string | undefined> = {
+    AZURE_OPENID_CONFIG_JWKS_URI: jwksUri,
+    AZURE_OPENID_CONFIG_ISSUER: issuer,
+    AZURE_APP_CLIENT_ID: audience,
+    IDPORTEN_ISSUER: undefined,
+  };
+  for (const [name, value] of Object.entries(env)) {
+    const original = process.env[name];
+    t.after(() => {
+      if (original === undefined) delete process.env[name];
+      else process.env[name] = original;
+    });
+    if (value === undefined) delete process.env[name];
+    else process.env[name] = value;
+  }
+
+  const now = Math.floor(Date.now() / 1000);
+  const sign = (claims: JWTPayload = {}, key = privateKey) =>
+    new SignJWT({
+      iss: issuer,
+      aud: audience,
+      sub: "test-saksbehandler",
+      iat: now,
+      exp: now + 300,
+      ...claims,
+    }).setProtectedHeader({ alg: "RS256", kid: "test-key" }).sign(key);
+
+  const validation = await validateToken(await sign());
+  assert.ok(validation.ok, validation.ok ? undefined : validation.error);
+
+  const routes = [
+    { path: "/api/saker", get: saker, status: 200, body: listSaker() },
+    { path: "/api/intern/saker", get: interneSaker, status: 200, body: listInterneSaker() },
+    {
+      path: "/api/intern/saker/101",
+      get: (request: Request) => internSak(request, { params: Promise.resolve({ id: "101" }) }),
+      status: 200,
+      body: finnInternSak(101),
+    },
+    {
+      path: "/api/intern/saker/999",
+      get: (request: Request) => internSak(request, { params: Promise.resolve({ id: "999" }) }),
+      status: 404,
+      body: { error: "Fant ikke saken" },
+    },
+  ];
+  const invalidTokens = [
+    { name: "manglende token", token: undefined, error: "Mangler token" },
+    { name: "vilkårlig token", token: "not-a-jwt", error: "Ugyldig token" },
+    { name: "feil signatur", token: await sign({}, wrongKey), error: "Ugyldig token" },
+    { name: "utløpt token", token: await sign({ exp: now - 600 }), error: "Ugyldig token" },
+    { name: "feil issuer", token: await sign({ iss: "https://wrong.example.test" }), error: "Ugyldig token" },
+    { name: "feil audience", token: await sign({ aud: "another-app" }), error: "Ugyldig token" },
+    { name: "token som ikke er gyldig ennå", token: await sign({ nbf: now + 600 }), error: "Ugyldig token" },
+  ];
+
+  for (const route of routes) {
+    for (const invalid of invalidTokens) {
+      await t.test(`${route.path} avviser ${invalid.name}`, async () => {
+        const request = new Request(`http://localhost${route.path}`, {
+          headers: invalid.token ? { Authorization: `Bearer ${invalid.token}` } : {},
+        });
+        const response = await route.get(request);
+        assert.equal(response.status, 401);
+        assert.deepEqual(await response.json(), { error: invalid.error });
+      });
+    }
+    await t.test(`${route.path} godtar gyldig Azure-token`, async () => {
+      const request = new Request(`http://localhost${route.path}`, {
+        headers: { Authorization: `Bearer ${await sign()}` },
+      });
+      const response = await route.get(request);
+      assert.equal(response.status, route.status);
+      assert.deepEqual(await response.json(), route.body);
+    });
+  }
 });
