@@ -0,0 +1,157 @@
+package no.nav.benchmark
+
+import io.ktor.client.HttpClient
+import io.ktor.client.engine.mock.MockEngine
+import io.ktor.client.engine.mock.respond
+import io.ktor.client.request.forms.FormDataContent
+import io.ktor.http.HttpHeaders
+import io.ktor.http.HttpStatusCode
+import io.ktor.http.headersOf
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.runBlocking
+import java.time.Clock
+import java.time.Instant
+import java.time.ZoneId
+import java.time.ZoneOffset
+import java.util.concurrent.atomic.AtomicInteger
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class TokenCacheTest {
+    private val json = headersOf(HttpHeaders.ContentType, "application/json")
+    private val start = Instant.parse("2026-03-04T10:00:00Z")
+
+    @Test
+    fun `isolates users audiences and rotated input tokens while reusing valid tokens`() = runBlocking {
+        val calls = AtomicInteger()
+        val engine = MockEngine { request ->
+            calls.incrementAndGet()
+            val form = (request.body as FormDataContent).formData
+            val token = "${form["user_token"]}-${form["target"]}"
+            respond("""{"access_token":"$token","expires_in":3600}""", headers = json)
+        }
+        HttpClient(engine).use { http ->
+            val clock = Clock.fixed(start, ZoneOffset.UTC)
+            val cache = TokenCache(TexasClient(http, clock), clock)
+
+            assertEquals("user-a-api-a", cache.token("user-a", "api-a"))
+            assertEquals("user-b-api-a", cache.token("user-b", "api-a"))
+            assertEquals("user-a-api-b", cache.token("user-a", "api-b"))
+            assertEquals("user-a-rotated-api-a", cache.token("user-a-rotated", "api-a"))
+            assertEquals("user-a-api-a", cache.token("user-a", "api-a"))
+            assertEquals("user-b-api-a", cache.token("user-b", "api-a"))
+            assertEquals(4, calls.get())
+        }
+    }
+
+    @Test
+    fun `simultaneous exchanges cannot pollute another users cache entry`() = runBlocking {
+        val entered = AtomicInteger()
+        val bothEntered = CompletableDeferred<Unit>()
+        val engine = MockEngine { request ->
+            val user = (request.body as FormDataContent).formData["user_token"]
+            if (entered.incrementAndGet() == 2) bothEntered.complete(Unit)
+            bothEntered.await()
+            respond("""{"access_token":"exchanged-$user","expires_in":3600}""", headers = json)
+        }
+        HttpClient(engine).use { http ->
+            val clock = Clock.fixed(start, ZoneOffset.UTC)
+            val cache = TokenCache(TexasClient(http, clock), clock)
+            val users = listOf("user-a", "user-b")
+
+            val results = coroutineScope {
+                users.map { user -> async { cache.token(user, "api") } }.awaitAll()
+            }
+
+            assertEquals(listOf("exchanged-user-a", "exchanged-user-b"), results)
+            users.forEach { user -> assertEquals("exchanged-$user", cache.token(user, "api")) }
+            assertEquals(2, entered.get())
+        }
+    }
+
+    @Test
+    fun `refreshes at thirty seconds remaining and again after expiry`() = runBlocking {
+        val clock = MutableClock(start)
+        val calls = AtomicInteger()
+        val engine = MockEngine {
+            val number = calls.incrementAndGet()
+            respond("""{"access_token":"exchanged-$number","expires_in":3600}""", headers = json)
+        }
+        HttpClient(engine).use { http ->
+            val cache = TokenCache(TexasClient(http, clock), clock)
+            assertEquals("exchanged-1", cache.token("user", "api"))
+
+            clock.now = start.plusSeconds(3570).minusNanos(1)
+            assertEquals("exchanged-1", cache.token("user", "api"))
+            assertEquals(1, calls.get())
+
+            clock.now = start.plusSeconds(3570)
+            assertEquals("exchanged-2", cache.token("user", "api"))
+            assertEquals(2, calls.get())
+
+            clock.now = start.plusSeconds(7171)
+            assertEquals("exchanged-3", cache.token("user", "api"))
+            assertEquals(3, calls.get())
+        }
+    }
+
+    @Test
+    fun `expiry is measured before the exchange so latency cannot extend token lifetime`() = runBlocking {
+        val clock = MutableClock(start)
+        val engine = MockEngine {
+            clock.now = start.plusSeconds(10)
+            respond("""{"access_token":"test-token","expires_in":3600}""", headers = json)
+        }
+        HttpClient(engine).use { http ->
+            val token = TexasClient(http, clock).exchange("user", "api")
+            assertEquals(start.plusSeconds(3600), token.expiresAt)
+        }
+    }
+
+    @Test
+    fun `failed refresh propagates without returning an unsafe cached token`() = runBlocking {
+        val clock = MutableClock(start)
+        val calls = AtomicInteger()
+        val engine = MockEngine {
+            when (calls.incrementAndGet()) {
+                2 -> respond("exchange failed", HttpStatusCode.ServiceUnavailable)
+                else -> respond(
+                    """{"access_token":"exchanged-${calls.get()}","expires_in":3600}""",
+                    headers = json,
+                )
+            }
+        }
+        HttpClient(engine).use { http ->
+            val cache = TokenCache(TexasClient(http, clock), clock)
+            assertEquals("exchanged-1", cache.token("user", "api"))
+            clock.now = start.plusSeconds(3571)
+
+            val error = assertFailsWith<TexasException> { cache.token("user", "api") }
+            assertEquals("Texas svarte 503", error.message)
+            assertEquals("exchanged-3", cache.token("user", "api"))
+            assertEquals(3, calls.get())
+        }
+    }
+
+    @Test
+    fun `validity requires more than thirty seconds remaining`() {
+        val token = OboToken("test-token", start.plusSeconds(3600))
+        assertTrue(token.isValid(start.plusSeconds(3570).minusNanos(1)))
+        assertFalse(token.isValid(start.plusSeconds(3570)))
+        assertFalse(token.isValid(start.plusSeconds(3571)))
+        assertFalse(token.isValid(start.plusSeconds(3600)))
+        assertFalse(token.isValid(start.plusSeconds(3601)))
+    }
+
+    private class MutableClock(var now: Instant) : Clock() {
+        override fun instant(): Instant = now
+        override fun getZone(): ZoneId = ZoneOffset.UTC
+        override fun withZone(zone: ZoneId): Clock = Clock.fixed(now, zone)
+    }
+}
