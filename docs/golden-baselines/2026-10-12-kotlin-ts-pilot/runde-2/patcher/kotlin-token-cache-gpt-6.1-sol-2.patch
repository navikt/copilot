@@ -0,0 +1,225 @@
+package no.nav.benchmark
+
+import io.ktor.client.HttpClient
+import io.ktor.client.engine.mock.MockEngine
+import io.ktor.client.engine.mock.respond
+import io.ktor.client.request.forms.FormDataContent
+import io.ktor.http.HttpHeaders
+import io.ktor.http.HttpStatusCode
+import io.ktor.http.headersOf
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import java.time.Clock
+import java.time.Duration
+import java.time.Instant
+import java.time.ZoneId
+import java.time.ZoneOffset
+import java.util.concurrent.atomic.AtomicInteger
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+import kotlin.test.assertIs
+import kotlin.test.assertTrue
+
+class TokenCacheTest {
+    private val json = headersOf(HttpHeaders.ContentType, "application/json")
+    private val start = Instant.parse("2026-03-04T10:00:00Z")
+
+    @Test
+    fun `cache isolates users audiences and renewed input tokens`() = runBlocking {
+        val calls = mutableListOf<Pair<String, String>>()
+        val engine = MockEngine { request ->
+            val form = assertIs<FormDataContent>(request.body).formData
+            calls.add(requireNotNull(form["user_token"]) to requireNotNull(form["target"]))
+            respond("""{"access_token":"exchanged-${calls.size}","expires_in":3600}""", headers = json)
+        }
+        HttpClient(engine).use { http ->
+            val clock = MutableClock(start)
+            val cache = TokenCache(TexasClient(http, clock), clock)
+            assertEquals("exchanged-1", cache.token("user-a", VEDTAK_AUDIENCE))
+            assertEquals("exchanged-2", cache.token("user-b", VEDTAK_AUDIENCE))
+            assertEquals("exchanged-3", cache.token("user-a", ARKIV_AUDIENCE))
+            assertEquals("exchanged-4", cache.token("user-a-renewed", VEDTAK_AUDIENCE))
+            assertEquals("exchanged-1", cache.token("user-a", VEDTAK_AUDIENCE))
+            assertEquals("exchanged-2", cache.token("user-b", VEDTAK_AUDIENCE))
+            assertEquals("exchanged-3", cache.token("user-a", ARKIV_AUDIENCE))
+            assertEquals("exchanged-4", cache.token("user-a-renewed", VEDTAK_AUDIENCE))
+            assertEquals(
+                listOf(
+                    "user-a" to VEDTAK_AUDIENCE,
+                    "user-b" to VEDTAK_AUDIENCE,
+                    "user-a" to ARKIV_AUDIENCE,
+                    "user-a-renewed" to VEDTAK_AUDIENCE,
+                ),
+                calls,
+            )
+        }
+    }
+
+    @Test
+    fun `refreshes at leeway boundary and never reuses expired tokens`() = runBlocking {
+        for (leeway in listOf(Duration.ZERO, Duration.ofSeconds(30), Duration.ofSeconds(120))) {
+            for (age in listOf(3600L - leeway.seconds, 3600L, 3601L)) {
+                val calls = AtomicInteger()
+                val engine = MockEngine {
+                    respond(
+                        """{"access_token":"exchanged-${calls.incrementAndGet()}","expires_in":3600}""",
+                        headers = json,
+                    )
+                }
+                HttpClient(engine).use { http ->
+                    val clock = MutableClock(start)
+                    val cache = TokenCache(TexasClient(http, clock), clock, leeway)
+                    assertEquals("exchanged-1", cache.token("user-a", VEDTAK_AUDIENCE))
+                    clock.now = start.plusSeconds(3600L - leeway.seconds).minusNanos(1)
+                    assertEquals("exchanged-1", cache.token("user-a", VEDTAK_AUDIENCE))
+                    clock.now = start.plusSeconds(age)
+                    assertEquals("exchanged-2", cache.token("user-a", VEDTAK_AUDIENCE))
+                    assertEquals(2, calls.get())
+                }
+            }
+        }
+    }
+
+    @Test
+    fun `concurrent requests share one exchange on miss and refresh`() = runBlocking {
+        withTimeout(5_000) {
+            for (warmCache in listOf(false, true)) {
+                val calls = AtomicInteger()
+                val entered = CompletableDeferred<Unit>()
+                val release = CompletableDeferred<Unit>()
+                val engine = MockEngine {
+                    val number = calls.incrementAndGet()
+                    if (!warmCache || number > 1) {
+                        entered.complete(Unit)
+                        release.await()
+                    }
+                    respond("""{"access_token":"exchanged-$number","expires_in":3600}""", headers = json)
+                }
+                HttpClient(engine).use { http ->
+                    val clock = MutableClock(start)
+                    val cache = TokenCache(TexasClient(http, clock), clock)
+                    if (warmCache) {
+                        cache.token("user-a", VEDTAK_AUDIENCE)
+                        clock.now = start.plusSeconds(3570)
+                    }
+                    val requests = List(100) {
+                        async(start = CoroutineStart.UNDISPATCHED) {
+                            cache.token("user-a", VEDTAK_AUDIENCE)
+                        }
+                    }
+                    entered.await()
+                    val expectedCalls = if (warmCache) 2 else 1
+                    assertEquals(expectedCalls, calls.get())
+                    release.complete(Unit)
+                    assertEquals(List(100) { "exchanged-$expectedCalls" }, requests.awaitAll())
+                    assertEquals(expectedCalls, calls.get())
+                }
+            }
+        }
+    }
+
+    @Test
+    fun `different keys exchange while another key is blocked`() = runBlocking {
+        withTimeout(5_000) {
+            val entered = CompletableDeferred<Unit>()
+            val release = CompletableDeferred<Unit>()
+            val calls = AtomicInteger()
+            val engine = MockEngine { request ->
+                calls.incrementAndGet()
+                val form = assertIs<FormDataContent>(request.body).formData
+                if (form["user_token"] == "user-a" && form["target"] == VEDTAK_AUDIENCE) {
+                    entered.complete(Unit)
+                    release.await()
+                }
+                respond("""{"access_token":"exchanged","expires_in":3600}""", headers = json)
+            }
+            HttpClient(engine).use { http ->
+                val clock = MutableClock(start)
+                val cache = TokenCache(TexasClient(http, clock), clock)
+                val blocked = async { cache.token("user-a", VEDTAK_AUDIENCE) }
+                entered.await()
+                assertEquals("exchanged", cache.token("user-b", VEDTAK_AUDIENCE))
+                assertEquals("exchanged", cache.token("user-a", ARKIV_AUDIENCE))
+                assertEquals(3, calls.get())
+                release.complete(Unit)
+                assertEquals("exchanged", blocked.await())
+            }
+        }
+    }
+
+    @Test
+    fun `failed refresh propagates and next request retries without stale fallback`() = runBlocking {
+        val calls = AtomicInteger()
+        val engine = MockEngine {
+            val number = calls.incrementAndGet()
+            if (number == 2) {
+                respond("unavailable", HttpStatusCode.ServiceUnavailable)
+            } else {
+                respond("""{"access_token":"exchanged-$number","expires_in":3600}""", headers = json)
+            }
+        }
+        HttpClient(engine).use { http ->
+            val clock = MutableClock(start)
+            val cache = TokenCache(TexasClient(http, clock), clock)
+            assertEquals("exchanged-1", cache.token("user-a", VEDTAK_AUDIENCE))
+            clock.now = start.plusSeconds(3570)
+            val failure = assertFailsWith<TexasException> { cache.token("user-a", VEDTAK_AUDIENCE) }
+            assertEquals("Texas svarte 503", failure.message)
+            assertEquals("exchanged-3", cache.token("user-a", VEDTAK_AUDIENCE))
+            assertEquals("exchanged-3", cache.token("user-a", VEDTAK_AUDIENCE))
+            assertEquals(3, calls.get())
+        }
+    }
+
+    @Test
+    fun `cancelled exchange releases the key for waiting requests`() = runBlocking {
+        withTimeout(5_000) {
+            val calls = AtomicInteger()
+            val entered = CompletableDeferred<Unit>()
+            val engine = MockEngine {
+                if (calls.incrementAndGet() == 1) {
+                    entered.complete(Unit)
+                    CompletableDeferred<Unit>().await()
+                }
+                respond("""{"access_token":"exchanged","expires_in":3600}""", headers = json)
+            }
+            HttpClient(engine).use { http ->
+                val clock = MutableClock(start)
+                val cache = TokenCache(TexasClient(http, clock), clock)
+                val cancelled = async { cache.token("user-a", VEDTAK_AUDIENCE) }
+                entered.await()
+                val waiting = async(start = CoroutineStart.UNDISPATCHED) {
+                    cache.token("user-a", VEDTAK_AUDIENCE)
+                }
+                cancelled.cancelAndJoin()
+                assertTrue(cancelled.isCancelled)
+                assertEquals("exchanged", waiting.await())
+                assertEquals(2, calls.get())
+            }
+        }
+    }
+
+    @Test
+    fun `Texas response latency does not extend token lifetime`() = runBlocking {
+        val clock = MutableClock(start)
+        val engine = MockEngine {
+            clock.now = start.plusSeconds(10)
+            respond("""{"access_token":"exchanged","expires_in":3600}""", headers = json)
+        }
+        HttpClient(engine).use { http ->
+            assertEquals(start.plusSeconds(3600), TexasClient(http, clock).exchange("user-a", VEDTAK_AUDIENCE).expiresAt)
+        }
+    }
+
+    private class MutableClock(@Volatile var now: Instant) : Clock() {
+        override fun instant(): Instant = now
+        override fun getZone(): ZoneId = ZoneOffset.UTC
+        override fun withZone(zone: ZoneId): Clock = Clock.fixed(now, zone)
+    }
+}
