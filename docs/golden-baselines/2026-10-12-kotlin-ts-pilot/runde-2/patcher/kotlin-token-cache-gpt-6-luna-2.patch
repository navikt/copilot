+package no.nav.benchmark
+
+import io.ktor.client.HttpClient
+import io.ktor.client.engine.mock.MockEngine
+import io.ktor.client.engine.mock.respond
+import java.time.Clock
+import java.time.Duration
+import java.time.Instant
+import java.time.ZoneOffset
+import java.util.concurrent.atomic.AtomicInteger
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.runBlocking
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class TokenCacheTest {
+    private val now = Instant.parse("2026-03-04T10:00:00Z")
+    private val audience = "dev-gcp:vedtak:vedtak-api"
+
+    @Test
+    fun `caches tokens separately for each user`() = runBlocking {
+        val exchangeCount = AtomicInteger()
+        val texas = TexasClient(
+            HttpClient(MockEngine {
+                val number = exchangeCount.incrementAndGet()
+                respond("""{"access_token":"token-$number","expires_in":3600}""")
+            }),
+            Clock.fixed(now, ZoneOffset.UTC),
+        )
+        val cache = TokenCache(texas, Clock.fixed(now, ZoneOffset.UTC))
+
+        assertEquals("token-1", cache.token("user-a", audience))
+        assertEquals("token-2", cache.token("user-b", audience))
+        assertEquals("token-1", cache.token("user-a", audience))
+        assertEquals(2, exchangeCount.get())
+    }
+
+    @Test
+    fun `refreshes token within the configured expiry leeway`() = runBlocking {
+        val exchangeCount = AtomicInteger()
+        val texas = TexasClient(
+            HttpClient(MockEngine {
+                val number = exchangeCount.incrementAndGet()
+                respond("""{"access_token":"token-$number","expires_in":3600}""")
+            }),
+            Clock.fixed(now, ZoneOffset.UTC),
+        )
+        val cacheClock = Clock.fixed(now.plusSeconds(3590), ZoneOffset.UTC)
+        val cache = TokenCache(texas, cacheClock, Duration.ofSeconds(30))
+
+        cache.token("user-a", audience)
+        assertEquals("token-2", cache.token("user-a", audience))
+        assertEquals(2, exchangeCount.get())
+    }
+
+    @Test
+    fun `shares one exchange between concurrent requests for the same user`() = runBlocking {
+        val exchangeCount = AtomicInteger()
+        val exchangeStarted = CompletableDeferred<Unit>()
+        val finishExchange = CompletableDeferred<Unit>()
+        val texas = TexasClient(
+            HttpClient(MockEngine {
+                exchangeCount.incrementAndGet()
+                exchangeStarted.complete(Unit)
+                finishExchange.await()
+                respond("""{"access_token":"shared-token","expires_in":3600}""")
+            }),
+            Clock.fixed(now, ZoneOffset.UTC),
+        )
+        val cache = TokenCache(texas, Clock.fixed(now, ZoneOffset.UTC))
+        val requests = List(20) {
+            async(Dispatchers.Default) { cache.token("user-a", audience) }
+        }
+
+        exchangeStarted.await()
+        finishExchange.complete(Unit)
+
+        assertEquals(List(20) { "shared-token" }, requests.awaitAll())
+        assertEquals(1, exchangeCount.get())
+    }
+}
