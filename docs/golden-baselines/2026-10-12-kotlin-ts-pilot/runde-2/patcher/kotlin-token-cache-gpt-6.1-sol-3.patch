+package no.nav.benchmark
+
+import io.ktor.client.HttpClient
+import io.ktor.client.engine.mock.MockEngine
+import io.ktor.client.engine.mock.respond
+import io.ktor.http.HttpHeaders
+import io.ktor.http.HttpStatusCode
+import io.ktor.http.content.OutgoingContent
+import io.ktor.http.headersOf
+import io.ktor.http.parseQueryString
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import java.time.Clock
+import java.time.Duration
+import java.time.Instant
+import java.time.ZoneId
+import java.time.ZoneOffset
+import java.util.concurrent.atomic.AtomicInteger
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+
+class TokenCacheTest {
+    private val json = headersOf(HttpHeaders.ContentType, "application/json")
+    private val start = Instant.parse("2026-03-04T10:00:00Z")
+
+    @Test
+    fun `isolates incoming tokens and audiences while reusing identical keys`() = runBlocking {
+        val clock = MutableClock(start)
+        val exchanges = AtomicInteger()
+        HttpClient(MockEngine { request ->
+            exchanges.incrementAndGet()
+            val form = parseQueryString((request.body as OutgoingContent.ByteArrayContent).bytes().decodeToString())
+            respond(
+                """{"access_token":"${form["user_token"]}:${form["target"]}","expires_in":3600}""",
+                headers = json,
+            )
+        }).use { http ->
+            val cache = TokenCache(TexasClient(http, clock), clock)
+            for (incoming in listOf("user-a-session-1", "user-b-session-1", "user-a-session-2")) {
+                for (audience in listOf(VEDTAK_AUDIENCE, ARKIV_AUDIENCE)) {
+                    repeat(2) {
+                        assertEquals("$incoming:$audience", cache.token(incoming, audience))
+                    }
+                }
+            }
+            assertEquals(6, exchanges.get())
+        }
+    }
+
+    @Test
+    fun `refreshes at the configured leeway boundary`() = runBlocking {
+        val clock = MutableClock(start)
+        val exchanges = AtomicInteger()
+        HttpClient(MockEngine {
+            respond("""{"access_token":"exchanged-${exchanges.incrementAndGet()}","expires_in":3600}""", headers = json)
+        }).use { http ->
+            val cache = TokenCache(TexasClient(http, clock), clock, Duration.ofSeconds(60))
+            assertEquals("exchanged-1", cache.token("user-a", VEDTAK_AUDIENCE))
+            clock.now = start.plusSeconds(3539)
+            assertEquals("exchanged-1", cache.token("user-a", VEDTAK_AUDIENCE))
+            clock.now = start.plusSeconds(3540)
+            assertEquals("exchanged-2", cache.token("user-a", VEDTAK_AUDIENCE))
+            clock.now = start.plusSeconds(7200)
+            assertEquals("exchanged-3", cache.token("user-a", VEDTAK_AUDIENCE))
+            assertEquals(3, exchanges.get())
+        }
+    }
+
+    @Test
+    fun `does not reuse a token at exact expiry with zero leeway`() = runBlocking {
+        val clock = MutableClock(start)
+        val exchanges = AtomicInteger()
+        HttpClient(MockEngine {
+            respond("""{"access_token":"exchanged-${exchanges.incrementAndGet()}","expires_in":3600}""", headers = json)
+        }).use { http ->
+            val cache = TokenCache(TexasClient(http, clock), clock, Duration.ZERO)
+            assertEquals("exchanged-1", cache.token("user-a", VEDTAK_AUDIENCE))
+            clock.now = start.plusSeconds(3600)
+            assertEquals("exchanged-2", cache.token("user-a", VEDTAK_AUDIENCE))
+        }
+    }
+
+    @Test
+    fun `counts Texas request time against token lifetime`() = runBlocking {
+        val clock = MutableClock(start)
+        HttpClient(MockEngine {
+            clock.now = start.plusSeconds(20)
+            respond("""{"access_token":"exchanged","expires_in":3600}""", headers = json)
+        }).use { http ->
+            assertEquals(start.plusSeconds(3600), TexasClient(http, clock).exchange("user-a", VEDTAK_AUDIENCE).expiresAt)
+        }
+    }
+
+    @Test
+    fun `concurrent misses and refreshes share one exchange`() = runBlocking {
+        withTimeout(5000) {
+            val clock = MutableClock(start)
+            val exchanges = AtomicInteger()
+            var entered = CompletableDeferred<Unit>()
+            var release = CompletableDeferred<Unit>()
+            HttpClient(MockEngine {
+                val number = exchanges.incrementAndGet()
+                entered.complete(Unit)
+                release.await()
+                respond("""{"access_token":"exchanged-$number","expires_in":3600}""", headers = json)
+            }).use { http ->
+                val cache = TokenCache(TexasClient(http, clock), clock)
+                repeat(2) { round ->
+                    entered = CompletableDeferred()
+                    release = CompletableDeferred()
+                    val leader = async { cache.token("user-a", VEDTAK_AUDIENCE) }
+                    entered.await()
+                    val followers = List(50) {
+                        async(start = CoroutineStart.UNDISPATCHED) { cache.token("user-a", VEDTAK_AUDIENCE) }
+                    }
+                    assertEquals(round + 1, exchanges.get())
+                    release.complete(Unit)
+                    assertEquals(List(51) { "exchanged-${round + 1}" }, (followers + leader).awaitAll())
+                    assertEquals(round + 1, exchanges.get())
+                    clock.now = start.plusSeconds(3570)
+                }
+            }
+        }
+    }
+
+    @Test
+    fun `a slow exchange does not block other users or audiences`() = runBlocking {
+        withTimeout(5000) {
+            val clock = MutableClock(start)
+            val entered = CompletableDeferred<Unit>()
+            val release = CompletableDeferred<Unit>()
+            val exchanges = AtomicInteger()
+            HttpClient(MockEngine { request ->
+                exchanges.incrementAndGet()
+                val form = parseQueryString((request.body as OutgoingContent.ByteArrayContent).bytes().decodeToString())
+                if (form["user_token"] == "user-a" && form["target"] == VEDTAK_AUDIENCE) {
+                    entered.complete(Unit)
+                    release.await()
+                }
+                respond("""{"access_token":"exchanged","expires_in":3600}""", headers = json)
+            }).use { http ->
+                val cache = TokenCache(TexasClient(http, clock), clock)
+                val slow = async { cache.token("user-a", VEDTAK_AUDIENCE) }
+                entered.await()
+                assertEquals("exchanged", cache.token("user-b", VEDTAK_AUDIENCE))
+                assertEquals("exchanged", cache.token("user-a", ARKIV_AUDIENCE))
+                release.complete(Unit)
+                assertEquals("exchanged", slow.await())
+                assertEquals(3, exchanges.get())
+            }
+        }
+    }
+
+    @Test
+    fun `shares exchange failures and allows a later retry`() = runBlocking {
+        withTimeout(5000) {
+            val clock = MutableClock(start)
+            val entered = CompletableDeferred<Unit>()
+            val release = CompletableDeferred<Unit>()
+            val exchanges = AtomicInteger()
+            HttpClient(MockEngine {
+                if (exchanges.incrementAndGet() == 1) {
+                    entered.complete(Unit)
+                    release.await()
+                    respond("unavailable", HttpStatusCode.ServiceUnavailable)
+                } else {
+                    respond("""{"access_token":"recovered","expires_in":3600}""", headers = json)
+                }
+            }).use { http ->
+                val cache = TokenCache(TexasClient(http, clock), clock)
+                val leader = async {
+                    assertFailsWith<TexasException> { cache.token("user-a", VEDTAK_AUDIENCE) }
+                }
+                entered.await()
+                val followers = List(20) {
+                    async(start = CoroutineStart.UNDISPATCHED) {
+                        assertFailsWith<TexasException> { cache.token("user-a", VEDTAK_AUDIENCE) }
+                    }
+                }
+                release.complete(Unit)
+                for (failure in (followers + leader).awaitAll()) {
+                    assertEquals("Texas svarte 503", failure.message)
+                }
+                assertEquals(1, exchanges.get())
+                assertEquals("recovered", cache.token("user-a", VEDTAK_AUDIENCE))
+                assertEquals(2, exchanges.get())
+            }
+        }
+    }
+
+    @Test
+    fun `cancelling a waiter does not cancel the shared exchange`() = runBlocking {
+        withTimeout(5000) {
+            val clock = MutableClock(start)
+            val entered = CompletableDeferred<Unit>()
+            val release = CompletableDeferred<Unit>()
+            val exchanges = AtomicInteger()
+            HttpClient(MockEngine {
+                exchanges.incrementAndGet()
+                entered.complete(Unit)
+                release.await()
+                respond("""{"access_token":"exchanged","expires_in":3600}""", headers = json)
+            }).use { http ->
+                val cache = TokenCache(TexasClient(http, clock), clock)
+                val leader = async { cache.token("user-a", VEDTAK_AUDIENCE) }
+                entered.await()
+                val waiter = async(start = CoroutineStart.UNDISPATCHED) { cache.token("user-a", VEDTAK_AUDIENCE) }
+                waiter.cancelAndJoin()
+                release.complete(Unit)
+                assertEquals("exchanged", leader.await())
+                assertEquals("exchanged", cache.token("user-a", VEDTAK_AUDIENCE))
+                assertEquals(1, exchanges.get())
+            }
+        }
+    }
+
+    @Test
+    fun `cancelling the exchange owner releases waiters and allows retry`() = runBlocking {
+        withTimeout(5000) {
+            val clock = MutableClock(start)
+            val entered = CompletableDeferred<Unit>()
+            val release = CompletableDeferred<Unit>()
+            val exchanges = AtomicInteger()
+            HttpClient(MockEngine {
+                if (exchanges.incrementAndGet() == 1) {
+                    entered.complete(Unit)
+                    release.await()
+                }
+                respond("""{"access_token":"exchanged","expires_in":3600}""", headers = json)
+            }).use { http ->
+                val cache = TokenCache(TexasClient(http, clock), clock)
+                val leader = async { cache.token("user-a", VEDTAK_AUDIENCE) }
+                entered.await()
+                val waiter = async(start = CoroutineStart.UNDISPATCHED) {
+                    assertFailsWith<CancellationException> { cache.token("user-a", VEDTAK_AUDIENCE) }
+                }
+                leader.cancelAndJoin()
+                release.complete(Unit)
+                waiter.await()
+                assertEquals("exchanged", cache.token("user-a", VEDTAK_AUDIENCE))
+                assertEquals(2, exchanges.get())
+            }
+        }
+    }
+
+    @Test
+    fun `failed refresh does not return the previous token`() = runBlocking {
+        val clock = MutableClock(start)
+        val exchanges = AtomicInteger()
+        HttpClient(MockEngine {
+            when (exchanges.incrementAndGet()) {
+                1 -> respond("""{"access_token":"original","expires_in":3600}""", headers = json)
+                2 -> respond("unavailable", HttpStatusCode.ServiceUnavailable)
+                else -> respond("""{"access_token":"recovered","expires_in":3600}""", headers = json)
+            }
+        }).use { http ->
+            val cache = TokenCache(TexasClient(http, clock), clock)
+            assertEquals("original", cache.token("user-a", VEDTAK_AUDIENCE))
+            clock.now = start.plusSeconds(3570)
+            assertFailsWith<TexasException> { cache.token("user-a", VEDTAK_AUDIENCE) }
+            assertEquals("recovered", cache.token("user-a", VEDTAK_AUDIENCE))
+            assertEquals(3, exchanges.get())
+        }
+    }
+
+    private class MutableClock(@Volatile var now: Instant) : Clock() {
+        override fun instant(): Instant = now
+        override fun getZone(): ZoneId = ZoneOffset.UTC
+        override fun withZone(zone: ZoneId): Clock = this
+    }
+}
