+package no.nav.benchmark
+
+import io.ktor.client.HttpClient
+import io.ktor.client.engine.mock.MockEngine
+import io.ktor.client.engine.mock.respond
+import io.ktor.http.HttpHeaders
+import io.ktor.http.HttpStatusCode
+import io.ktor.http.headersOf
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import java.time.Clock
+import java.time.Duration
+import java.time.Instant
+import java.time.ZoneId
+import java.time.ZoneOffset
+import java.util.concurrent.atomic.AtomicInteger
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+import kotlin.test.assertIs
+
+class TokenCacheTest {
+    private val json = headersOf(HttpHeaders.ContentType, "application/json")
+
+    @Test
+    fun `isolates incoming tokens and audiences and reuses exact matches`() = runBlocking {
+        val calls = AtomicInteger()
+        val clock = MutableClock()
+        val engine = MockEngine {
+            respond(tokenBody("exchanged-${calls.incrementAndGet()}"), headers = json)
+        }
+        HttpClient(engine).use { http ->
+            val cache = TokenCache(TexasClient(http, clock), clock)
+            assertEquals("exchanged-1", cache.token("user-a", VEDTAK_AUDIENCE))
+            assertEquals("exchanged-2", cache.token("user-b", VEDTAK_AUDIENCE))
+            assertEquals("exchanged-3", cache.token("user-a", ARKIV_AUDIENCE))
+            assertEquals("exchanged-4", cache.token("user-a-renewed", VEDTAK_AUDIENCE))
+            assertEquals("exchanged-1", cache.token("user-a", VEDTAK_AUDIENCE))
+            assertEquals("exchanged-2", cache.token("user-b", VEDTAK_AUDIENCE))
+            assertEquals("exchanged-3", cache.token("user-a", ARKIV_AUDIENCE))
+            assertEquals(4, calls.get())
+        }
+    }
+
+    @Test
+    fun `refreshes at the exact configured margin and after expiry`() = runBlocking {
+        val calls = AtomicInteger()
+        val clock = MutableClock()
+        val engine = MockEngine {
+            respond(tokenBody("exchanged-${calls.incrementAndGet()}"), headers = json)
+        }
+        HttpClient(engine).use { http ->
+            val cache = TokenCache(TexasClient(http, clock), clock, Duration.ofSeconds(60))
+            assertEquals("exchanged-1", cache.token("user", VEDTAK_AUDIENCE))
+            clock.advance(Duration.ofSeconds(3539))
+            assertEquals("exchanged-1", cache.token("user", VEDTAK_AUDIENCE))
+            clock.advance(Duration.ofSeconds(1))
+            assertEquals("exchanged-2", cache.token("user", VEDTAK_AUDIENCE))
+            clock.advance(Duration.ofSeconds(3600))
+            assertEquals("exchanged-3", cache.token("user", VEDTAK_AUDIENCE))
+            assertEquals(3, calls.get())
+        }
+    }
+
+    @Test
+    fun `counts Texas response time against token lifetime`() = runBlocking {
+        val clock = MutableClock()
+        val requestedAt = clock.instant()
+        val engine = MockEngine {
+            clock.advance(Duration.ofSeconds(20))
+            respond(tokenBody("exchanged"), headers = json)
+        }
+        HttpClient(engine).use { http ->
+            assertEquals(requestedAt.plusSeconds(3600), TexasClient(http, clock).exchange("user", VEDTAK_AUDIENCE).expiresAt)
+        }
+    }
+
+    @Test
+    fun `shares one exchange for concurrent misses and refreshes`() = runBlocking {
+        withTimeout(5000) {
+            val calls = AtomicInteger()
+            val clock = MutableClock()
+            var started = CompletableDeferred<Unit>()
+            var release = CompletableDeferred<Unit>()
+            val engine = MockEngine {
+                val number = calls.incrementAndGet()
+                started.complete(Unit)
+                release.await()
+                respond(tokenBody("exchanged-$number"), headers = json)
+            }
+            HttpClient(engine).use { http ->
+                val cache = TokenCache(TexasClient(http, clock), clock)
+                repeat(2) { round ->
+                    val requests = List(40) {
+                        async(start = CoroutineStart.UNDISPATCHED) { cache.token("user", VEDTAK_AUDIENCE) }
+                    }
+                    started.await()
+                    assertEquals(round + 1, calls.get())
+                    release.complete(Unit)
+                    assertEquals(List(40) { "exchanged-${round + 1}" }, requests.awaitAll())
+                    clock.advance(Duration.ofSeconds(3570))
+                    started = CompletableDeferred()
+                    release = CompletableDeferred()
+                }
+                assertEquals(2, calls.get())
+            }
+        }
+    }
+
+    @Test
+    fun `does not block other keys behind a slow exchange`() = runBlocking {
+        withTimeout(5000) {
+            val calls = AtomicInteger()
+            val clock = MutableClock()
+            val started = CompletableDeferred<Unit>()
+            val release = CompletableDeferred<Unit>()
+            val engine = MockEngine {
+                val number = calls.incrementAndGet()
+                if (number == 1) {
+                    started.complete(Unit)
+                    release.await()
+                }
+                respond(tokenBody("exchanged-$number"), headers = json)
+            }
+            HttpClient(engine).use { http ->
+                val cache = TokenCache(TexasClient(http, clock), clock)
+                val slow = async { cache.token("user-a", VEDTAK_AUDIENCE) }
+                started.await()
+                assertEquals("exchanged-2", cache.token("user-b", VEDTAK_AUDIENCE))
+                assertEquals("exchanged-3", cache.token("user-a", ARKIV_AUDIENCE))
+                release.complete(Unit)
+                assertEquals("exchanged-1", slow.await())
+            }
+        }
+    }
+
+    @Test
+    fun `shares exchange failures and allows a later retry`() = runBlocking {
+        withTimeout(5000) {
+            val calls = AtomicInteger()
+            val clock = MutableClock()
+            val started = CompletableDeferred<Unit>()
+            val release = CompletableDeferred<Unit>()
+            val engine = MockEngine {
+                if (calls.incrementAndGet() == 1) {
+                    started.complete(Unit)
+                    release.await()
+                    respond("unavailable", HttpStatusCode.ServiceUnavailable)
+                } else {
+                    respond(tokenBody("retried"), headers = json)
+                }
+            }
+            HttpClient(engine).use { http ->
+                val cache = TokenCache(TexasClient(http, clock), clock)
+                val requests = List(20) {
+                    async(start = CoroutineStart.UNDISPATCHED) {
+                        runCatching { cache.token("user", VEDTAK_AUDIENCE) }
+                    }
+                }
+                started.await()
+                assertEquals(1, calls.get())
+                release.complete(Unit)
+                requests.awaitAll().forEach { assertIs<TexasException>(it.exceptionOrNull()) }
+                assertEquals(1, calls.get())
+                assertEquals("retried", cache.token("user", VEDTAK_AUDIENCE))
+                assertEquals(2, calls.get())
+            }
+        }
+    }
+
+    @Test
+    fun `cancelling a waiter does not cancel the exchange`() = runBlocking {
+        withTimeout(5000) {
+            val clock = MutableClock()
+            val calls = AtomicInteger()
+            val started = CompletableDeferred<Unit>()
+            val release = CompletableDeferred<Unit>()
+            val engine = MockEngine {
+                calls.incrementAndGet()
+                started.complete(Unit)
+                release.await()
+                respond(tokenBody("exchanged"), headers = json)
+            }
+            HttpClient(engine).use { http ->
+                val cache = TokenCache(TexasClient(http, clock), clock)
+                val owner = async { cache.token("user", VEDTAK_AUDIENCE) }
+                started.await()
+                val waiter = async(start = CoroutineStart.UNDISPATCHED) { cache.token("user", VEDTAK_AUDIENCE) }
+                waiter.cancelAndJoin()
+                release.complete(Unit)
+                assertEquals("exchanged", owner.await())
+                assertEquals("exchanged", cache.token("user", VEDTAK_AUDIENCE))
+                assertEquals(1, calls.get())
+            }
+        }
+    }
+
+    @Test
+    fun `cancelling the exchange owner releases waiters and allows retry`() = runBlocking {
+        withTimeout(5000) {
+            val clock = MutableClock()
+            val calls = AtomicInteger()
+            val started = CompletableDeferred<Unit>()
+            val engine = MockEngine {
+                if (calls.incrementAndGet() == 1) {
+                    started.complete(Unit)
+                    CompletableDeferred<Unit>().await()
+                }
+                respond(tokenBody("retried"), headers = json)
+            }
+            HttpClient(engine).use { http ->
+                val cache = TokenCache(TexasClient(http, clock), clock)
+                val owner = async { cache.token("user", VEDTAK_AUDIENCE) }
+                started.await()
+                val waiter = async(start = CoroutineStart.UNDISPATCHED) {
+                    runCatching { cache.token("user", VEDTAK_AUDIENCE) }
+                }
+                owner.cancelAndJoin()
+                assertIs<kotlinx.coroutines.CancellationException>(waiter.await().exceptionOrNull())
+                assertEquals("retried", cache.token("user", VEDTAK_AUDIENCE))
+                assertEquals(2, calls.get())
+            }
+        }
+    }
+
+    @Test
+    fun `rejects unusable fresh tokens without caching them`() = runBlocking {
+        val clock = MutableClock()
+        val calls = AtomicInteger()
+        val lifetimes = listOf(30, 0, -1, 3600)
+        val engine = MockEngine {
+            respond(tokenBody("exchanged", lifetimes[calls.getAndIncrement()]), headers = json)
+        }
+        HttpClient(engine).use { http ->
+            val cache = TokenCache(TexasClient(http, clock), clock)
+            repeat(3) { assertFailsWith<TexasException> { cache.token("user", VEDTAK_AUDIENCE) } }
+            assertEquals("exchanged", cache.token("user", VEDTAK_AUDIENCE))
+            assertEquals("exchanged", cache.token("user", VEDTAK_AUDIENCE))
+            assertEquals(4, calls.get())
+        }
+    }
+
+    private fun tokenBody(token: String, lifetime: Int = 3600) =
+        """{"access_token":"$token","expires_in":$lifetime,"token_type":"Bearer"}"""
+
+    private class MutableClock : Clock() {
+        private var now = Instant.parse("2026-03-04T10:00:00Z")
+        override fun instant(): Instant = now
+        override fun getZone(): ZoneId = ZoneOffset.UTC
+        override fun withZone(zone: ZoneId): Clock = Clock.fixed(now, zone)
+        fun advance(duration: Duration) {
+            now = now.plus(duration)
+        }
+    }
+}
