 import assert from "node:assert/strict";
 import { test } from "node:test";
+import { exportJWK, generateKeyPair, SignJWT } from "jose";
 import { GET as isalive } from "../app/api/isalive/route.ts";
+import { GET as isready } from "../app/api/isready/route.ts";
 import { GET as saker } from "../app/api/saker/route.ts";
+import { GET as interneSaker } from "../app/api/intern/saker/route.ts";
+import { GET as internSak } from "../app/api/intern/saker/[id]/route.ts";
+import { POST as notat } from "../app/api/intern/saker/[id]/notater/route.ts";
+import { listInterneSaker } from "../lib/saker.ts";
 
 test("isalive svarer uten token", async () => {
   assert.equal((await isalive()).status, 200);
 });
 
+test("isready svarer uten token", async () => {
+  assert.equal((await isready()).status, 200);
+});
+
 test("saker krever token", async () => {
   assert.equal((await saker(new Request("http://localhost/api/saker"))).status, 401);
+});
+
+test("interne ruter validerer Azure-token før tilgang til saker", async (t) => {
+  const issuer = "https://issuer.example.test";
+  const audience = "saksoversikt-test";
+  const jwksUri = `${issuer}/jwks`;
+  const { privateKey, publicKey } = await generateKeyPair("RS256");
+  const { privateKey: otherKey } = await generateKeyPair("RS256");
+  const jwk = { ...await exportJWK(publicKey), kid: "test-key", alg: "RS256" };
+  t.mock.method(globalThis, "fetch", async (input: string | URL | Request) => {
+    assert.equal(input instanceof Request ? input.url : String(input), jwksUri);
+    return Response.json({ keys: [jwk] });
+  });
+
+  const env = {
+    AZURE_OPENID_CONFIG_ISSUER: issuer,
+    AZURE_APP_CLIENT_ID: audience,
+    AZURE_OPENID_CONFIG_JWKS_URI: jwksUri,
+    IDPORTEN_ISSUER: undefined,
+  };
+  const previousEnv = Object.fromEntries(
+    Object.keys(env).map((key) => [key, process.env[key]]),
+  );
+  for (const [key, value] of Object.entries(env)) {
+    if (value === undefined) delete process.env[key];
+    else process.env[key] = value;
+  }
+
+  async function token({
+    iss = issuer,
+    aud = audience,
+    exp = Math.floor(Date.now() / 1000) + 3600,
+    key = privateKey,
+  } = {}): Promise<string> {
+    return new SignJWT({})
+      .setProtectedHeader({ alg: "RS256", kid: "test-key" })
+      .setSubject("test-saksbehandler")
+      .setIssuer(iss)
+      .setAudience(aud)
+      .setExpirationTime(exp)
+      .sign(key);
+  }
+
+  const routes = [
+    { path: "/api/intern/saker", method: "GET", handler: interneSaker },
+    { path: "/api/intern/saker/101", method: "GET", handler: internSak },
+    { path: "/api/intern/saker/101/notater", method: "POST", handler: notat },
+  ];
+  function request(path: string, method: string, bearer?: string, body = '{"tekst":"Testnotat"}') {
+    return new Request(`http://localhost${path}`, {
+      method,
+      headers: bearer ? { Authorization: `Bearer ${bearer}` } : {},
+      body: method === "POST" ? body : undefined,
+    });
+  }
+  const context = () => ({ params: Promise.resolve({ id: "101" }) });
+  const originalSaker = structuredClone(listInterneSaker());
+
+  try {
+    const rejected = [
+      { name: "manglende token", bearer: undefined, error: "Mangler token" },
+      { name: "vilkårlig token", bearer: "not-a-jwt", error: "Ugyldig token" },
+      { name: "feil signatur", bearer: await token({ key: otherKey }), error: "Ugyldig token" },
+      { name: "utløpt token", bearer: await token({ exp: Math.floor(Date.now() / 1000) - 3600 }), error: "Ugyldig token" },
+      { name: "feil issuer", bearer: await token({ iss: "https://other.example.test" }), error: "Ugyldig token" },
+      { name: "feil audience", bearer: await token({ aud: "other-app" }), error: "Ugyldig token" },
+    ];
+    for (const route of routes) {
+      for (const invalid of rejected) {
+        await t.test(`${route.method} ${route.path} avviser ${invalid.name}`, async () => {
+          const response = await route.handler(
+            request(route.path, route.method, invalid.bearer),
+            context(),
+          );
+          assert.equal(response.status, 401);
+          assert.deepEqual(await response.json(), { error: invalid.error });
+          assert.deepEqual(listInterneSaker(), originalSaker);
+        });
+      }
+    }
+
+    await t.test("notater avviser ugyldig token før parsing av body", async () => {
+      const response = await notat(
+        request("/api/intern/saker/101/notater", "POST", "not-a-jwt", "{"),
+        context(),
+      );
+      assert.equal(response.status, 401);
+      assert.deepEqual(listInterneSaker(), originalSaker);
+    });
+
+    const valid = await token();
+    for (const route of routes) {
+      await t.test(`${route.method} ${route.path} godtar gyldig token`, async () => {
+        const response = await route.handler(
+          request(route.path, route.method, valid),
+          context(),
+        );
+        assert.equal(response.status, route.method === "POST" ? 201 : 200);
+        const expected = route.method === "POST"
+          ? { ...originalSaker[0], internNotat: `${originalSaker[0].internNotat}\nTestnotat` }
+          : route.path === "/api/intern/saker" ? originalSaker : originalSaker[0];
+        assert.deepEqual(await response.json(), expected);
+      });
+    }
+  } finally {
+    for (const [key, value] of Object.entries(previousEnv)) {
+      if (value === undefined) delete process.env[key];
+      else process.env[key] = value;
+    }
+    for (const sak of listInterneSaker()) {
+      const original = originalSaker.find((item) => item.id === sak.id);
+      assert.ok(original);
+      sak.internNotat = original.internNotat;
+    }
+  }
 });
