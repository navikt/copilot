@@ -0,0 +1,119 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { exportJWK, generateKeyPair, SignJWT } from "jose";
+import { GET as listSaker } from "../app/api/intern/saker/route.ts";
+import { GET as hentSak } from "../app/api/intern/saker/[id]/route.ts";
+import { POST as skrivNotat } from "../app/api/intern/saker/[id]/notater/route.ts";
+import { finnInternSak, listInterneSaker } from "../lib/saker.ts";
+
+const routes = [
+  {
+    path: "/api/intern/saker",
+    method: "GET",
+    handler: listSaker,
+  },
+  {
+    path: "/api/intern/saker/101",
+    method: "GET",
+    handler: (request: Request) => hentSak(request, { params: Promise.resolve({ id: "101" }) }),
+  },
+  {
+    path: "/api/intern/saker/101/notater",
+    method: "POST",
+    handler: (request: Request) => skrivNotat(request, { params: Promise.resolve({ id: "101" }) }),
+  },
+];
+
+test("interne saker krever validerte tokens", async (t) => {
+  const issuer = "https://issuer.example.test";
+  const audience = "saksoversikt-test";
+  const jwksUri = `${issuer}/jwks`;
+  const env = {
+    AZURE_OPENID_CONFIG_ISSUER: issuer,
+    AZURE_APP_CLIENT_ID: audience,
+    AZURE_OPENID_CONFIG_JWKS_URI: jwksUri,
+    IDPORTEN_ISSUER: undefined,
+  };
+  const originalEnv = new Map(Object.keys(env).map((name) => [name, process.env[name]]));
+  t.after(() => {
+    for (const [name, value] of originalEnv) {
+      if (value === undefined) delete process.env[name];
+      else process.env[name] = value;
+    }
+  });
+  for (const [name, value] of Object.entries(env)) {
+    if (value === undefined) delete process.env[name];
+    else process.env[name] = value;
+  }
+
+  const { publicKey, privateKey } = await generateKeyPair("RS256");
+  const jwk = await exportJWK(publicKey);
+  t.mock.method(globalThis, "fetch", async (input: string | URL | Request) => {
+    const url = input instanceof Request ? input.url : String(input);
+    assert.equal(url, jwksUri, "testen skal ikke hente eksterne ressurser");
+    return Response.json({ keys: [{ ...jwk, kid: "test-key", alg: "RS256" }] });
+  });
+
+  const now = Math.floor(Date.now() / 1000);
+  const claims = { iss: issuer, aud: audience, sub: "test-user", exp: now + 300 };
+  const sign = (payload = claims, key = privateKey) =>
+    new SignJWT(payload).setProtectedHeader({ alg: "RS256", kid: "test-key" }).sign(key);
+  const otherKey = await generateKeyPair("RS256");
+  const invalidTokens = [
+    { name: "manglende token", token: undefined, error: "Mangler token" },
+    { name: "vilkårlig token", token: "ikke-et-jwt", error: "Ugyldig token" },
+    { name: "utløpt token", token: await sign({ ...claims, exp: now - 60 }), error: "Ugyldig token" },
+    { name: "feil issuer", token: await sign({ ...claims, iss: `${issuer}/other` }), error: "Ugyldig token" },
+    { name: "feil audience", token: await sign({ ...claims, aud: "other-app" }), error: "Ugyldig token" },
+    { name: "feil signatur", token: await sign(claims, otherKey.privateKey), error: "Ugyldig token" },
+  ];
+
+  for (const route of routes) {
+    for (const { name, token, error } of invalidTokens) {
+      await t.test(`${route.method} ${route.path} avviser ${name}`, async () => {
+        const before = structuredClone(listInterneSaker());
+        const request = new Request(`http://localhost${route.path}`, {
+          method: route.method,
+          headers: token ? { Authorization: `Bearer ${token}` } : {},
+          body: route.method === "POST" ? JSON.stringify({ tekst: "Skal ikke lagres" }) : undefined,
+        });
+        const response = await route.handler(request);
+        assert.equal(response.status, 401);
+        assert.deepEqual(await response.json(), { error });
+        assert.deepEqual(listInterneSaker(), before);
+        assert.equal(request.bodyUsed, false);
+      });
+    }
+  }
+
+  const token = await sign();
+  await t.test("gyldig token gir liste og detaljer", async () => {
+    const headers = { Authorization: `Bearer ${token}` };
+    const list = await listSaker(new Request("http://localhost/api/intern/saker", { headers }));
+    assert.equal(list.status, 200);
+    assert.deepEqual(await list.json(), listInterneSaker());
+    const detail = await hentSak(new Request("http://localhost/api/intern/saker/101", { headers }), {
+      params: Promise.resolve({ id: "101" }),
+    });
+    assert.equal(detail.status, 200);
+    assert.deepEqual(await detail.json(), finnInternSak(101));
+  });
+
+  await t.test("gyldig token kan legge til notat", async () => {
+    const sak = finnInternSak(101);
+    assert.ok(sak);
+    const originalNotat = sak.internNotat;
+    try {
+      const response = await skrivNotat(new Request("http://localhost/api/intern/saker/101/notater", {
+        method: "POST",
+        headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
+        body: JSON.stringify({ tekst: "Testnotat" }),
+      }), { params: Promise.resolve({ id: "101" }) });
+      assert.equal(response.status, 201);
+      assert.deepEqual(await response.json(), { ...sak, internNotat: `${originalNotat}\nTestnotat` });
+      assert.equal(sak.internNotat, `${originalNotat}\nTestnotat`);
+    } finally {
+      sak.internNotat = originalNotat;
+    }
+  });
+});
